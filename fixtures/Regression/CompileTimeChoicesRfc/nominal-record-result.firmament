Model Result {
 units: mm
 Options SizeChoice { Compact Standard }
 Record PlateSpec { width: Length }
 Static small: PlateSpec = PlateSpec { width: 40mm }
 Static large: PlateSpec = PlateSpec { width: 80mm }
 Static choice: SizeChoice = Compact
 Record OtherSpec { width: Length }
 Static other: OtherSpec = OtherSpec { width: 80mm }
 Static selected: PlateSpec = match choice { Compact => small; Standard => other }
 Template<spec: PlateSpec> Struct Plate { Box Stock { size: [spec.width, 20mm, 5mm] } }
 Struct Result = Plate<spec: selected>
}

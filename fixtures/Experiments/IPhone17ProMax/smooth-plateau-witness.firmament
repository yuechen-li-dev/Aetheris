// Smooth footprint witness: polynomial corners remove the line/arc curvature jump.
// No claim that this is the phone's finished plateau or a G2 transition.
Model SmoothPlateauWitness {
    Units: mm
    Concept Struct Frames {
        Base: Plane { Origin: [0mm,0mm,0mm] Normal: [0,0,1] Up: [0,1,0] }
        Top: Plane { Origin: [0mm,0mm,2.55mm] Normal: [0,0,1] Up: [0,1,0] }
    }
    Construction Plane BaseFrame { Trace: Frames.Base }
    Construction Plane TopFrame { Trace: Frames.Top }
    SmoothRoundedRect2 BaseOutline { Center: [0mm,0mm] Size: [72.76mm,43mm] CornerExtent: 11.5mm }
    Profile BaseProfile { Loop Outer { BaseOutline |> TraceLoop } }
    SectionChain Transition {
        Continuity: G1
        Section Base { Frame: BaseFrame
            Profile: BaseProfile
            Seam: Bottom }
        Section Top { Frame: TopFrame
            Profile: BaseProfile
            Seam: Bottom }
        Start: Cap
        End: Cap
    }
}


schema Mechanical

Model ProfilePipelineFlagship {
    units: mm

    Concept Struct Layout on XY {
        Rect2 Stock { center: [0mm, 0mm]; size: [40mm, 24mm] }
        Rect2 Pad { center: [-10mm, 0mm]; size: [10mm, 10mm] }
        Rect2 Cutout { center: [10mm, 0mm]; size: [8mm, 8mm] }
    }

    Profile BaseProfile using Layout { Loop Outer {
        Segment Bottom { trace: Stock.Bottom; from: Stock.BottomLeft; to: Stock.BottomRight }
        Segment Right { trace: Stock.Right; from: Stock.BottomRight; to: Stock.TopRight }
        Segment Top { trace: Stock.Top; from: Stock.TopRight; to: Stock.TopLeft }
        Segment Left { trace: Stock.Left; from: Stock.TopLeft; to: Stock.BottomLeft }
    } }
    Profile PadProfile using Layout { Loop Outer {
        Segment Bottom { trace: Pad.Bottom; from: Pad.BottomLeft; to: Pad.BottomRight }
        Segment Right { trace: Pad.Right; from: Pad.BottomRight; to: Pad.TopRight }
        Segment Top { trace: Pad.Top; from: Pad.TopRight; to: Pad.TopLeft }
        Segment Left { trace: Pad.Left; from: Pad.TopLeft; to: Pad.BottomLeft }
    } }
    Profile CutoutProfile using Layout { Loop Outer {
        Segment Bottom { trace: Cutout.Bottom; from: Cutout.BottomLeft; to: Cutout.BottomRight }
        Segment Right { trace: Cutout.Right; from: Cutout.BottomRight; to: Cutout.TopRight }
        Segment Top { trace: Cutout.Top; from: Cutout.TopRight; to: Cutout.TopLeft }
        Segment Left { trace: Cutout.Left; from: Cutout.TopLeft; to: Cutout.BottomLeft }
    } }

    Struct Part { Compose Body {
        Base StockBody { profile: BaseProfile; from: 0mm; to: 8mm; role: Stock }
        Add RaisedPad { Profile: PadProfile; From: 8mm; To: 12mm; Role: Boss }
        Remove ThroughCutout { Profile: CutoutProfile; From: 0mm; To: 8mm; Role: ThroughCut }
    } }
}

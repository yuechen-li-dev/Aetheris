// fixture-id: inline-step-v2-recognized-face-datum-pmi-emits-in-step
// case: inline-step-v2-recognized-face-datum-pmi-emits-in-step
// category: InlineStep
// syntax-version: FirmamentV2
// validity: valid
// implementation: parser-backed
// expected: valid
// tier: inline-step
// expected-stage: step-verified
// current-stage: step-verified
// feature-area: inline-step-recognition-labels
// build-command: aetheris build
// roundtrip-required: true
// expected-volume: 480
// expected-topology: faces=6, vertices=8, edges=12
// canonical-input-required: true
// recognized-region-required: true
// semantic-pmi-required: true
// graphical-pmi-required: false
// input-step: ../testdata/canonical-box-10x8x6.step
// semantic-pmi-evidence: SHAPE_ASPECT('firmament-datum:A'), PROPERTY_DEFINITION('datum:A:importedPart')
// notes: INLINE-STEP-X3 labels imported face #40 as topFace datumPlane metadata and routes datum PMI through Step242Exporter; no graphical PMI or geometry replacement.
model InlineStepRecognizedFaceDatumPmi {
    units mm

    solid importedPart: InlineStep {
        path: "../testdata/canonical-box-10x8x6.step"
    }

    recognize importedPart {
        region topFace {
            kind: datumPlane
            faces: ["#40"]
            confidence: high
        }
    }

    pmi {
        datum A {
            target: importedPart.region("topFace")
        }
    }
}

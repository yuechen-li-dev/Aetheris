Template<H: Length> Struct Post {
 Circle2 Outline { center: [0mm,0mm]; radius: 2mm }
 Profile P { Loop Outer { Outline |> TraceLoop } }
 Extrude Body { profile: P; from: 0mm; to: H }
 expose { Semantic Bottom { DatumFrame Frame = [0mm,0mm,0mm] x [1,0,0] y [0,1,0] z [0,0,1]; } }
}
Subassembly Tuner {
 <Assembly Tuner>
  <Part Post = Post<H:8mm>> Placement { from: Bottom.Frame; to: World; } </Part>
  <Part Button = Post<H:3mm>> Placement { from: Bottom.Frame; to: World; translateLocal: [-5mm,0mm,0mm]; } </Part>
 </Assembly>
 anchor: Tuner;
 expose { DatumFrame Mount = Post.Bottom.Frame; }
}
Linear Sites BassSites {
 keys: [Low, Middle, High];
 start: [-10mm,20mm,0mm];
 step: [0mm,30mm,0mm];
}
Mirrored Sites TrebleSites from BassSites { Across: YZ; }
Assembly MountingRows {
 <Assembly MountingRows>
  Pattern BassRow over BassSites {
   site => <Assembly Unit = Tuner>
    Placement { from: Mount; to: Tilt.Frame; translateLocal: [site.X,site.Y,site.Z]; }
   </Assembly>
  }
  Pattern TrebleRow over TrebleSites {
   site => <Assembly Unit = Tuner>
    Placement { from: Mount; to: Tilt.Frame; translateLocal: [site.X,site.Y,site.Z]; rotateLocal: { axis: Z; angle: 180deg } }
   </Assembly>
  }
 </Assembly>
 FrameTransform Tilt { from: World; translateLocal: [0mm,0mm,7mm]; rotateLocal: { axis: X; angle: -13deg } }
 anchor: MountingRows;
}

// current-stage: step-verified
// expected-feature-air: AirHoleFeature(Counterbore)
// dimensions: base box 10 x 8 x 6; shaft radius 1 through depth 6; counterbore radius 2 depth 1
// units: mm
// tier: 2
// mvp-required: true
// feature-area: semantic-hole
// build-command: aetheris build
// expected-volume: 480 - (pi * 1^2 * 6 + pi * (2^2 - 1^2) * 1)
// expected-topology: advanced_face>0, vertex_point>0, shaft-cylinder=true, counterbore-cylinder=true
// roundtrip-required: true
// parser-backed: true
// notes: STEP-V2-X2 semantic counterbore fixture; verified through real build/export, Step242Exporter, reimport, topology markers, and analytic volume.
model FeatureV2CounterboreStepVerified {
  units mm
  solid base: Box { size: [10, 8, 6] }
  modify base {
    hole<counterbore> mount {
      on: face(+Z)
      center: [0, 0]
      shaftDiameter: 2
      counterboreDiameter: 4
      counterboreDepth: 1
      end: throughAll
    }
  }
}

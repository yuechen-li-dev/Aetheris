Model ProfileFilletConvexTwoSegmentTop {
Units: mm
Concept Struct RectangleLayout On XY {
    Point2 A { Position: [0mm, 0mm] } Point2 B { Position: [20mm, 0mm] }
    Point2 C { Position: [20mm, 10mm] } Point2 D { Position: [0mm, 10mm] }
    Line2 South { From: A; To: B } Line2 East { From: B; To: C }
    Line2 North { From: C; To: D } Line2 West { From: D; To: A }
}
Profile Bracket Using RectangleLayout { Loop Outer {
    Segment South { Trace: South; From: A; To: B } Segment East { Trace: East; From: B; To: C }
    Segment North { Trace: North; From: C; To: D } Segment West { Trace: West; From: D; To: A }
} }
Struct Body { Extrude Bracket { Profile: Bracket; From: 0mm; To: 8mm } }
Selection CornerPair { Source: Bracket.Outer.[South, East] Require: ConnectedChain }
Modify Body { EdgeFinish RoundedCorner { Target: CornerPair On: Top Kind: Fillet Radius: 2mm EndClearance: 3mm } }
Assert Volume Body {
    Expected: 1570.7317878719023mm^3
    Tolerance: 0.5mm^3
    Note: "Two straight Profile rolls joined by one convex spherical fillet junction"
}
}

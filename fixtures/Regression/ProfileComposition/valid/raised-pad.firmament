Concept Struct RaisedPadLayout On XY {
    Point2 A { Position: [-10mm, -10mm] }
    Point2 B { Position: [10mm, -10mm] }
    Point2 C { Position: [10mm, 10mm] }
    Point2 D { Position: [-10mm, 10mm] }
    Point2 E { Position: [-4mm, -4mm] }
    Point2 F { Position: [4mm, -4mm] }
    Point2 G { Position: [4mm, 4mm] }
    Point2 H { Position: [-4mm, 4mm] }
    Line2 AB { From: A; To: B } Line2 BC { From: B; To: C } Line2 CD { From: C; To: D } Line2 DA { From: D; To: A }
    Line2 EF { From: E; To: F } Line2 FG { From: F; To: G } Line2 GH { From: G; To: H } Line2 HE { From: H; To: E }
}
Profile Plate Using RaisedPadLayout {
    Loop Outer {
        AB
        |> BC
        |> CD
        |> DA
        |> Close
    }
}
Profile Pad Using RaisedPadLayout {
    Loop Outer {
        EF
        |> FG
        |> GH
        |> HE
        |> Close
    }
}
Struct RaisedPad {
    Compose Body {
        Base PrimaryPlate { Profile: Plate; From: 0mm; To: 10mm; Role: Stock }
        Add CentralPad { Profile: Pad; From: 10mm; To: 15mm; Role: Boss }
    }
}

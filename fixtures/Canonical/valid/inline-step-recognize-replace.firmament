Model InlineStepRecognizeReplace {
    Units: mm

    InlineStep Source {
        Path: "../../InlineStep/testdata/canonical-through-hole.step"
    }

    Recognize Source {
        Region MountHole {
            Kind: HoleShaft
            Confidence: High
            Faces: [7]
            Evidence: {
                SurfaceFamily: Cylindrical
                Radius: 1mm
                Through: true
            }
        }
    }

    Replace Source.MountHole With Hole<Shaft> MountHole {
        On: Source.Face(7)
        Center: Point2(0mm, 0mm)
        Diameter: 2mm
        End: ThroughAll
        HostSize: [10mm, 8mm, 6mm]
    }
}

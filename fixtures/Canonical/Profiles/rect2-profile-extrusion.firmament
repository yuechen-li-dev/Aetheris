Concept Struct Rect2Layout On XY {
    Rect2 Base { Center: [0mm, 0mm]; Size: [20mm, 10mm]; Role: ProfileGuide }
}
Profile MainPlate Using Rect2Layout {
    Loop Outer {
        Base.Bottom As South
        |> Base.Right As East
        |> Base.Top As North
        |> Base.Left As West
        |> Close
    }
}
Struct Plate { Extrude MainPlate { Profile: MainPlate; From: 0mm; To: 5mm } }

include "../construction";
include "valve-hardware-dimensions";

Struct SpringRetainer {
  Static outsideDiameter: Length = 24mm
  Static radialStemClearance: Length = 0.2mm
  Static thickness: Length = 3mm
  Static halfThickness: Length = thickness / 2
  Struct Stock = AnnulusStock<rout: outsideDiameter / 2, rin: valveStemDiameter / 2 + radialStemClearance, zmin: 0mm - halfThickness, zmax: halfThickness>

  expose {
    Semantic Mount {
      Axis Axis = [0,0,0] -> [0,0,1];
      DatumFrame Frame = [0,0,0] x [1,0,0] y [0,1,0] z [0,0,1];
    }
  }
}

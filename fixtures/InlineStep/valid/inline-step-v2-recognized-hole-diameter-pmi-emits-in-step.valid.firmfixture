// fixture-id: inline-step-v2-recognized-hole-diameter-pmi-emits-in-step
// case: inline-step-v2-recognized-hole-diameter-pmi-emits-in-step
// category: InlineStep
// syntax-version: FirmamentV2
// validity: valid
// implementation: parser-backed
// expected: valid
// tier: inline-step
// expected-stage: step-verified
// current-stage: step-verified
// feature-area: inline-step-recognition-labels
// build-command: aetheris build
// roundtrip-required: true
// expected-volume: 461.15044407846124
// expected-topology: faces=7
// canonical-input-required: true
// recognized-region-required: true
// semantic-pmi-required: true
// graphical-pmi-required: false
// input-step: ../testdata/canonical-through-hole.step
// semantic-pmi-evidence: SHAPE_DIMENSION_REPRESENTATION('diameter:importedPart.mountHoleDiameter'), PROPERTY_DEFINITION('diameter:importedPart.mountHoleDiameter')
// notes: INLINE-STEP-X3 labels imported cylindrical face #191 as mountHole holeShaft metadata and routes diameter PMI through Step242Exporter; no graphical PMI or geometry replacement.
model InlineStepRecognizedHoleDiameterPmi {
    units mm

    solid importedPart: InlineStep {
        path: "../testdata/canonical-through-hole.step"
    }

    recognize importedPart {
        region mountHole {
            kind: holeShaft
            faces: ["#191"]
            confidence: high
        }
    }

    pmi {
        diameter mountHoleDiameter {
            target: importedPart.region("mountHole")
            value: 2mm
        }
    }
}

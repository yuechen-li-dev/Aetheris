// fixture-id: inline-step-v2-record-pmi-datum-diameter-step-verified
// case: inline-step-v2-record-pmi-datum-diameter-step-verified
// category: InlineStep
// syntax-version: FirmamentV2
// validity: valid
// implementation: parser-backed
// expected: valid
// tier: inline-step
// expected-stage: step-verified
// current-stage: step-verified
// feature-area: v2-phase1-p2-record-pmi-ap242-export
// build-command: aetheris build
// roundtrip-required: true
// expected-volume: 461.15044407846124
// expected-topology: faces=7
// canonical-input-required: true
// recognized-region-required: true
// semantic-pmi-required: true
// graphical-pmi-required: false
// input-step: ../testdata/canonical-through-hole.step
// semantic-pmi-evidence: SHAPE_ASPECT('firmament-datum:A'), SHAPE_DIMENSION_REPRESENTATION('diameter:part.mountHoleADiameter'), SHAPE_DIMENSION_REPRESENTATION('diameter_tolerance:part.mountHoleADiameter')
// notes: P2 proves record-shaped datum and toleranced diameter PMI over the canonical through-hole InlineStep model; trace-stage step verification depends on matching the imported body's stable through-hole volume rather than the default 10x8x6 box volume.
model InlineStepRecordPmiDatumDiameter {
    units mm

    let MountingPattern {
        holeDiameter: length = 6.0mm tol 0.05mm
    }

    solid part: InlineStep {
        path: "../testdata/canonical-through-hole.step"
    }

    recognize part {
        region baseFace {
            kind: datumPlane
            faces: ["#51"]
            confidence: high
        }

        region mountHoleA {
            kind: holeShaft
            faces: ["#191"]
            confidence: high
        }
    }

    pmi {
        datum A {
            target: part.region("baseFace")
        }

        diameter mountHoleADiameter {
            target: part.region("mountHoleA")
            dimension: MountingPattern.holeDiameter
        }
    }
}

Model BentWireArc {
    units: mm
    Path Centerline {
        start: Point2(0mm, 0mm)
        heading: 0deg
        Arc Bend { Radius: 8mm; Turn: 180deg }
    }
    Sweep Wire {
        Path: Centerline
        Diameter: 1mm
        Material: Standard.Materials.StainlessSteel.304_Annealed
    }
}

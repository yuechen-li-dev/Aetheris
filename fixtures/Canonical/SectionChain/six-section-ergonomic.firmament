Model SixSectionErgonomic {
 units: mm
 Concept Struct Stations {
  P0: Plane { Origin: [0mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  P1: Plane { Origin: [14mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  P2: Plane { Origin: [30mm,1mm,1mm]; Normal: [1,0,0]; Up: [0,0,1] }
  P3: Plane { Origin: [48mm,2mm,2mm]; Normal: [1,0,0]; Up: [0,0,1] }
  P4: Plane { Origin: [66mm,1mm,1mm]; Normal: [1,0,0]; Up: [0,0,1] }
  P5: Plane { Origin: [82mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
 }
 Construction Plane F0 { Trace: Stations.P0 }
 Construction Plane F1 { Trace: Stations.P1 }
 Construction Plane F2 { Trace: Stations.P2 }
 Construction Plane F3 { Trace: Stations.P3 }
 Construction Plane F4 { Trace: Stations.P4 }
 Construction Plane F5 { Trace: Stations.P5 }

 Path O0 { start: Point2(-4mm,-3mm) heading: 0deg Line Bottom { length: 8mm } Line Right { Turn: 90deg; length: 6mm } Line Top { Turn: 90deg; length: 8mm } Close Left }
 Path O1 { start: Point2(-9mm,-6mm) heading: 0deg Line Bottom { length: 18mm } Line Right { Turn: 90deg; length: 12mm } Line Top { Turn: 90deg; length: 18mm } Close Left }
 Path O2 { start: Point2(-13mm,-9mm) heading: 0deg Line Bottom { length: 26mm } Line Right { Turn: 90deg; length: 18mm } Line Top { Turn: 90deg; length: 26mm } Close Left }
 Path O3 { start: Point2(-15mm,-10mm) heading: 0deg Line Bottom { length: 30mm } Line Right { Turn: 90deg; length: 20mm } Line Top { Turn: 90deg; length: 30mm } Close Left }
 Path O4 { start: Point2(-11mm,-7mm) heading: 0deg Line Bottom { length: 22mm } Line Right { Turn: 90deg; length: 14mm } Line Top { Turn: 90deg; length: 22mm } Close Left }
 Path O5 { start: Point2(-5mm,-3.5mm) heading: 0deg Line Bottom { length: 10mm } Line Right { Turn: 90deg; length: 7mm } Line Top { Turn: 90deg; length: 10mm } Close Left }
 Profile R0 from O0
 Profile R1 from O1
 Profile R2 from O2
 Profile R3 from O3
 Profile R4 from O4
 Profile R5 from O5

 SectionChain SixSectionErgonomic {
  Transition: Ruled
  Section Nose { frame: F0
   profile: R0
   seam: Bottom }
  Section Front { frame: F1
   profile: R1
   seam: Bottom }
  Section PalmFront { frame: F2
   profile: R2
   seam: Bottom }
  Section Peak { frame: F3
   profile: R3
   seam: Bottom }
  Section PalmRear { frame: F4
   profile: R4
   seam: Bottom }
  Section Tail { frame: F5
   profile: R5
   seam: Bottom }
  start: Cap
  end: Cap
 }
}

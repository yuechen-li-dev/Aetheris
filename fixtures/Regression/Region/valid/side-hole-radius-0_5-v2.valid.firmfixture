model SideHoleRadius05V2 {
    units mm

    solid base: Box {
        size: [10, 8, 6]
    }

    modify base {
        region sideHole on face(+X) {
            cut Cylinder {
                radius: 0.5
                through: face(-X)
            }
        }
    }
}

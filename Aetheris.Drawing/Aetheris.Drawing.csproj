<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Source-traceable engineering drawing notes, managed PDF inspection, and browser rendering.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <None Remove="Web/node_modules/**/*;Web/pdfjs/**/*;Web/pdfjs-dist/**/*;Web/package/**/*" />
  </ItemGroup>

  <Target Name="RestoreDrawingBrowserAssets"
          Inputs="Web/package.json;Web/package-lock.json"
          Outputs="Web/node_modules/.package-lock.json;Web/node_modules/pdfjs-dist/build/pdf.min.mjs;Web/node_modules/pdfjs-dist/build/pdf.worker.min.mjs">
    <Exec Command="npm ci --ignore-scripts --omit=optional --no-audit --no-fund"
          WorkingDirectory="$(MSBuildProjectDirectory)/Web" />
  </Target>

  <!-- Register after restore, so a fresh checkout needs no pre-existing vendor files.
       Explicit runtime inputs also keep extra upstream builds/maps/viewers out of packages. -->
  <Target Name="IncludeDrawingBrowserAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="RestoreDrawingBrowserAssets">
    <ItemGroup>
      <EmbeddedResource Include="Web/node_modules/pdfjs-dist/build/pdf.min.mjs" LogicalName="pdfjs/build/pdf.mjs" />
      <EmbeddedResource Include="Web/node_modules/pdfjs-dist/build/pdf.worker.min.mjs" LogicalName="pdfjs/build/pdf.worker.mjs" />
      <_DrawingPdfJsRuntimeAsset Include="Web/node_modules/pdfjs-dist/cmaps/*.bcmap;Web/node_modules/pdfjs-dist/cmaps/LICENSE" RuntimeDirectory="cmaps" />
      <_DrawingPdfJsRuntimeAsset Include="Web/node_modules/pdfjs-dist/standard_fonts/*.pfb;Web/node_modules/pdfjs-dist/standard_fonts/*.ttf;Web/node_modules/pdfjs-dist/standard_fonts/LICENSE*" RuntimeDirectory="standard_fonts" />
      <_DrawingPdfJsRuntimeAsset Include="Web/node_modules/pdfjs-dist/wasm/*.wasm;Web/node_modules/pdfjs-dist/wasm/*_nowasm_fallback.js;Web/node_modules/pdfjs-dist/wasm/quickjs-eval.js;Web/node_modules/pdfjs-dist/wasm/LICENSE*" RuntimeDirectory="wasm" />
      <_DrawingPdfJsRuntimeAsset Include="Web/node_modules/pdfjs-dist/iccs/*.icc;Web/node_modules/pdfjs-dist/iccs/LICENSE*" RuntimeDirectory="iccs" />
      <EmbeddedResource Include="@(_DrawingPdfJsRuntimeAsset)" LogicalName="pdfjs/%(_DrawingPdfJsRuntimeAsset.RuntimeDirectory)/%(_DrawingPdfJsRuntimeAsset.Filename)%(_DrawingPdfJsRuntimeAsset.Extension)" />
      <EmbeddedResource Include="Web/node_modules/pdfjs-dist/LICENSE" LogicalName="pdfjs/LICENSE" />
    </ItemGroup>
  </Target>
</Project>

Subassembly GuitarTuners {
 <Assembly GuitarTuners>
  Pattern TunerPosts Over TunerPostsSites {
   site => <Part TunerPost = Drum<R:4mm,H:8mm>>
    Placement { From: Origin; To: World; TranslateLocal: [site.X,site.Y,site.Z]; }
   </Part>
  }
  Pattern TunerWashers Over TunerWashersSites {
   site => <Part TunerWasher = Drum<R:7mm,H:1.5mm>>
    Placement { From: Origin; To: World; TranslateLocal: [site.X,site.Y,site.Z]; }
   </Part>
  }
  Pattern TunerButtons Over TunerButtonsSites {
   site => <Part TunerButton = Panel<L:15mm,W:19mm,H:6mm,R:5mm>>
    Placement { From: Origin; To: World; TranslateLocal: [site.X,site.Y,site.Z]; }
   </Part>
  }
 </Assembly>

 Anchor: GuitarTuners;
}

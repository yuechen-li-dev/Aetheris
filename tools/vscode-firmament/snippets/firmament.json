{
  "Model": {
    "prefix": "model",
    "body": ["Model ${1:Part} {", "    Units: mm", "", "    $0", "}"],
    "description": "Canonical Firmament model"
  },
  "Box": {
    "prefix": "box",
    "body": ["Box ${1:Base} {", "    Size: [${2:80mm}, ${3:50mm}, ${4:25mm}]", "}"],
    "description": "Box primitive"
  },
  "Cylinder": {
    "prefix": "cylinder",
    "body": ["Cylinder ${1:Body} {", "    Radius: ${2:20mm}", "    Height: ${3:40mm}", "}"],
    "description": "Cylinder primitive"
  },
  "Sphere": {
    "prefix": "sphere",
    "body": ["Sphere ${1:Body} {", "    Radius: ${2:20mm}", "}"],
    "description": "Canonical analytic sphere primitive"
  },
  "Cone": {
    "prefix": "cone",
    "body": ["Cone ${1:Body} {", "    BottomRadius: ${2:20mm}", "    TopRadius: ${3:0mm}", "    Height: ${4:40mm}", "}"],
    "description": "Canonical analytic cone primitive"
  },
  "Torus": {
    "prefix": "torus",
    "body": ["Torus ${1:Body} {", "    MajorRadius: ${2:20mm}", "    MinorRadius: ${3:5mm}", "}"],
    "description": "Canonical analytic torus primitive"
  },
  "Linear Analysis": {
    "prefix": "analysis-linear",
    "body": [
      "Analysis LinearElastic ${1:Check} {",
      "    Body: ${2:Body}",
      "    Material: ${3:Standard.Materials.Aluminum.6061_T6}",
      "    Fixed ${4:Root} { Region: ${2:Body}.face(-X) Components: [X, Y, Z] }",
      "    Force ${5:Tip} { Region: ${2:Body}.face(+X) Vector: [0N, ${6:-100N}, 0N] }",
      "    Results: [Displacement, Strain, Stress, ReactionForce]",
      "    Lattice: [${7:12}, ${8:2}, ${9:2}]",
      "}"
    ],
    "description": "Canonical linear-elastic analysis on ordinary Model geometry"
  },
  "Concept Path": {
    "prefix": "concept-path",
    "body": [
      "Concept Path ${1:Outline} {",
      "    Start: Point2(${2:0mm}, ${3:0mm})",
      "    Heading: ${4:0deg}",
      "    Line ${5:South} { Length: ${6:40mm} }",
      "    Close ${7:West}",
      "}"
    ],
    "description": "Concept Path declaration"
  },
  "Profile from Path": {
    "prefix": "profile-from-path",
    "body": ["Profile ${1:Section} From ${2:Outline}"],
    "description": "Profile derived from a Concept Path"
  },
  "Circular Sweep": {
    "prefix": "sweep-circular",
    "body": [
      "Sweep ${1:Wire} {",
      "    Path: ${2:Centerline}",
      "    Diameter: ${3:1mm}",
      "    Material: ${4:Standard.Materials.StainlessSteel.304_Annealed}",
      "}"
    ],
    "description": "Bounded constant circular Sweep along a planar Concept Path"
  },
  "Static Table with Override": {
    "prefix": "table-with",
    "body": [
      "Record ${1:PartSpec} {",
      "    Width: Length",
      "    Height: Length",
      "}",
      "Static Table ${2:Standards}: ${1:PartSpec} {",
      "    Width: [${3:40mm}, ${4:60mm}]",
      "    Height: [${5:20mm}, ${6:30mm}]",
      "}",
      "Static ${7:Standard} = ${2:Standards}[${8:0}]",
      "Static ${9:Configured}: ${1:PartSpec} = ${7:Standard} with {",
      "    Width: ${10:50mm}",
      "}"
    ],
    "description": "Typed Static Table lookup followed by an immutable with override"
  },
  "Profile Delta": {
    "prefix": "profile-delta",
    "body": [
      "Template<P: ${1:ProfileDeltaSpec}, Owner: ProfilePath>",
      "ProfileDelta ${2:LocalChange} {",
      "    On: Owner",
      "    Anchor: CenteredAt P.${3:Center}",
      "    Side: ${4:Inward}",
      "    Level Carrier { Offset: 0mm; }",
      "    Level Changed { Offset: P.${5:Depth}; }",
      "    Transition LeadIn { Kind: Diagonal; Run: P.${6:Lead}; To: Changed; }",
      "    Span Working { Run: P.${7:Run}; At: Changed; }",
      "    Transition LeadOut { Kind: Diagonal; Run: P.${6:Lead}; To: Carrier; }",
      "}"
    ],
    "description": "Reusable semantic ProfileDelta applicable to an ordinary Profile path"
  },
  "Boss": {
    "prefix": "boss",
    "body": [
      "Boss ${1:BossName} {",
      "    On: Top",
      "    Profile: ${2:BossProfile}",
      "    Height: ${3:8mm}",
      "}"
    ],
    "description": "Connected finite top-support Boss"
  },
  "Pocket": {
    "prefix": "pocket",
    "body": [
      "Pocket ${1:PocketName} {",
      "    On: Top",
      "    Profile: ${2:PocketProfile}",
      "    Depth: ${3:4mm}",
      "    MinimumFloorThickness: ${4:1mm}",
      "}"
    ],
    "description": "Finite top-support Pocket with explicit minimum floor"
  },
  "Hole Shaft": {
    "prefix": "hole-shaft",
    "body": [
      "Hole<Shaft> ${1:HoleName} {",
      "    On: ${2:+Z}",
      "    Center: Point2(${3:20mm}, ${4:20mm})",
      "    Diameter: ${5:8mm}",
      "    End: ThroughAll",
      "}"
    ],
    "description": "Through shaft hole"
  },
  "Hole Counterbore": {
    "prefix": "hole-counterbore",
    "body": [
      "Hole<Counterbore> ${1:HoleName} {",
      "    On: ${2:+Z}",
      "    Center: Point2(${3:0mm}, ${4:0mm})",
      "    Diameter: ${5:6mm}",
      "    CounterboreDiameter: ${6:11mm}",
      "    CounterboreDepth: ${7:4mm}",
      "    End: ThroughAll",
      "}"
    ],
    "description": "Counterbored through hole"
  },
  "Hole Countersink": {
    "prefix": "hole-countersink",
    "body": [
      "Hole<Countersink> ${1:HoleName} {",
      "    On: ${2:+Z}",
      "    Center: Point2(${3:0mm}, ${4:0mm})",
      "    Diameter: ${5:6mm}",
      "    CountersinkDiameter: ${6:12mm}",
      "    CountersinkAngle: ${7:90deg}",
      "    End: ThroughAll",
      "}"
    ],
    "description": "Countersunk through hole"
  },
  "Slot Capsule": {
    "prefix": "slot-capsule",
    "body": [
      "Slot<Capsule> ${1:SlotName} {",
      "    Center: Point2(${2:0mm}, ${3:0mm})",
      "    Direction: Vector2(${4:1}, ${5:0})",
      "    Length: ${6:30mm}",
      "    Width: ${7:8mm}",
      "    Extent: ThroughAll",
      "    Role: ${8:ThroughSlot}",
      "}"
    ],
    "description": "Capsule slot"
  },
  "EdgeFinish Chamfer": {
    "prefix": "edgefinish-chamfer",
    "body": [
      "EdgeFinish ${1:FinishName} {",
      "    Target: ${2:Body.Outer}",
      "    On: ${3:Top}",
      "    Kind: Chamfer",
      "    Distance: ${4:1mm}",
      "}"
    ],
    "description": "Chamfer edge finish"
  },
  "EdgeFinish Fillet": {
    "prefix": "edgefinish-fillet",
    "body": [
      "EdgeFinish ${1:FinishName} {",
      "    Target: ${2:Body.Outer}",
      "    On: ${3:Top}",
      "    Kind: Fillet",
      "    Radius: ${4:1mm}",
      "}"
    ],
    "description": "Fillet edge finish"
  },
  "Require": {
    "prefix": "require",
    "body": [
      "Require ${1:Constraint} {",
      "    Actual: ${2:Mount.Diameter}",
      "    Expected: ${3:8mm}",
      "    Tolerance: PlusMinus(${4:0.05mm}, ${5:0.05mm})",
      "}"
    ],
    "description": "Semantic requirement"
  },
  "Template": {
    "prefix": "template",
    "body": [
      "Template<${1:Spec}: ${2:PartSpec}>",
      "Struct ${3:PartFamily} {",
      "    Require ${4:Admissible} => ${1:Spec}.${5:Width} > 0mm",
      "    $0",
      "}"
    ],
    "description": "Typed compile-time engineering Template specialization"
  },
  "PMI Projection": {
    "prefix": "pmi-projection",
    "body": [
      "${1:HoleDiameter} ${2:DimensionName} {",
      "    From: ${3:Constraint}",
      "    As: ${1:HoleDiameter}",
      "    DatumRefs: [${4:A}]",
      "}"
    ],
    "description": "Project a validated requirement into PMI"
  },
  "Assert Volume": {
    "prefix": "assert-volume",
    "body": [
      "Assert Volume ${1:Base} {",
      "    Expected: ${2:100000mm^3}",
      "    Tolerance: ${3:1mm^3}",
      "    Note: \"${4:Expected material volume}\"",
      "}"
    ],
    "description": "Build-time volume assertion"
  },
  "Inline STEP": {
    "prefix": "inline-step",
    "body": ["InlineStep ${1:Source} {", "    Path: \"${2:part.step}\"", "}"],
    "description": "Inline a STEP source for recognition and replacement"
  }
}

// Engineer/LLM reconstruction of NIST CTC-03.
// M3 authority law: every construction dimension is present here. The recovered
// draft and source STEP are verification evidence and are not loaded to build it.
SheetMetal Ctc03 {
    Intent: Reconstructed;
    Thickness: 1.905mm;
    KFactor: 0.5;
    Material: "0.075 in nominal sheet";

    Base MainDeck {
        Profile: Rectangle { Width: 241.3mm; Height: 368.3mm; };
        Origin: (-241.3mm, 58.08726mm, 76.2mm);
    }

    Flange FrontWall { From: MainDeck.Front; Height: 61.59254mm; Angle: 90deg; Radius: 6.35mm; Direction: Down; Relief: Auto; }
    Flange RearWall  { From: MainDeck.Rear;  Height: 61.59254mm; Angle: 90deg; Radius: 6.35mm; Direction: Down; Relief: Auto; }
    Flange LeftWall  { From: MainDeck.Left;  Height: 44.45mm;  Angle: 90deg; Radius: 6.35mm; Direction: Up;   Relief: Auto; }
    Flange RightWall { From: MainDeck.Right; Height: 29.11094mm; Angle: 90deg; Radius: 6.35mm; Direction: Up; Relief: Auto; }

    Flange FrontMountingFlange { From: FrontWall.Outer; Length: 30.77972mm; Angle: 90deg; Radius: 6.35mm; Direction: Up; }
    Flange RearMountingFlange  { From: RearWall.Outer;  Length: 44.45mm;    Angle: 90deg; Radius: 6.35mm; Direction: Up; }
    Flange AngledServiceFlange { From: RightWall.Outer; Length: 48.514mm;   Angle: 45deg; Radius: 6.35mm; Direction: Down; }

    Cut VentSlotRight { On: MainDeck; Profile: Slot { Length: 19.05mm; Width: 88.9mm; }; At: (114.7826mm, 108.43514mm); }
    Cut VentSlotLeft  { On: MainDeck; Profile: Slot { Length: 19.05mm; Width: 88.9mm; }; At: (51.2826mm, 108.43514mm); }
}

schema Mechanical
Model PartialRadialPattern {
    units: mm
    Axis MainAxis { origin: [0mm,0mm,0mm]; direction: [0,0,1] }
    Box Plate { size: [80mm, 80mm, 8mm] }
    Modify Plate {
        Hole<Shaft> HoleSeed { on: +Z center: Point2(24mm, 0mm) diameter: 4mm end: ThroughAll }
        Radial Pattern HalfArc { source: HoleSeed about: MainAxis count: 5 angle: half }
    }
}

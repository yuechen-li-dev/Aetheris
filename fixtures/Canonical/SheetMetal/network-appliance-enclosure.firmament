Profile rearPowerInletProfile = Rect2 { center: [0mm, 0mm]; size: [12mm, 18mm] }
Profile rearEthernetProfile = Rect2 { center: [0mm, 0mm]; size: [14mm, 16mm] }
Profile leftVentAProfile = Rect2 { center: [0mm, 0mm]; size: [18mm, 3mm] }
Profile leftVentBProfile = Rect2 { center: [0mm, 0mm]; size: [18mm, 3mm] }
Profile rightVentAProfile = Rect2 { center: [0mm, 0mm]; size: [18mm, 3mm] }
Profile rightVentBProfile = Rect2 { center: [0mm, 0mm]; size: [18mm, 3mm] }

Use SheetMetal.ProductFamilies;

Static NetworkSpec: EnclosureSpec = EnclosureSpec {
    Width: 160mm
    Depth: 110mm
    Height: 36mm
    LidLipHeight: 7mm
    Thickness: 1.2mm
    InsideRadius: 1.5mm
    KFactor: 0.42
    ReliefPolicy: Rectangular
}

SheetMetal NetworkAppliance = ElectronicsEnclosure < Spec: NetworkSpec >

// Ordinary downstream authoring against the specialized object's semantic regions.
Extend SheetMetal NetworkAppliance {
    Hole FrontIndicatorGreen { on: Front; center: Point2(45mm, 18mm); diameter: 3mm; }
    Hole FrontIndicatorAmber { on: Front; center: Point2(55mm, 18mm); diameter: 3mm; }
    Cut RearPowerInlet { on: Rear; at: Point2(35mm, 18mm); profile: rearPowerInletProfile; }
    Cut RearEthernet { on: Rear; at: Point2(80mm, 18mm); profile: rearEthernetProfile; }
    Cut LeftVentA { on: Left; at: Point2(30mm, 15mm); profile: leftVentAProfile; }
    Cut LeftVentB { on: Left; at: Point2(55mm, 15mm); profile: leftVentBProfile; }
    Cut RightVentA { on: Right; at: Point2(30mm, 15mm); profile: rightVentAProfile; }
    Cut RightVentB { on: Right; at: Point2(55mm, 15mm); profile: rightVentBProfile; }
    Hole MountA { on: Body; center: Point2(25mm, 25mm); diameter: 3.2mm; }
    Hole MountB { on: Body; center: Point2(135mm, 25mm); diameter: 3.2mm; }
    Hole MountC { on: Body; center: Point2(25mm, 85mm); diameter: 3.2mm; }
    Hole MountD { on: Body; center: Point2(135mm, 85mm); diameter: 3.2mm; }
}

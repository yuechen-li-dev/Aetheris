schema Mechanical

Concept Path Outline {
    Start: Point2(0mm, 0mm)
    Heading: 0deg
    Line Bottom { Length: 30mm }
    Line Right { Turn: 90deg; Length: 20mm }
    Line Top { Turn: 90deg; Length: 30mm }
    Close Left
}

Profile Plate { Outline |> TraceLoop }
Extrude Solid { Profile: Plate; From: 0mm; To: 5mm }

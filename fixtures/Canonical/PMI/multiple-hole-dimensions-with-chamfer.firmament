Model MountingPlate {
    units: mm
    Box Plate { size: [80mm, 50mm, 8mm] }
    Modify Plate {
        Hole<Shaft> MountLeft { on: +Z center: Point2(-25mm, 0mm) diameter: 8mm end: ThroughAll }
        Hole<Shaft> MountRight { on: +Z center: Point2(25mm, 0mm) diameter: 8mm end: ThroughAll }
        EdgeFinish TopBreak { Face: +Z Target: Boundary Kind: Chamfer Distance: 1mm }
    }
    Pmi {
        Datum A { Target: face(+Z) }
        HoleDiameter MountLeftDiameter {
            Target: MountLeft
            Value: 8mm
            Tolerance: PlusMinus(0.10mm, 0.00mm)
        }
        HoleDiameter MountRightDiameter {
            Target: MountRight
            Value: 8mm
            Tolerance: PlusMinus(0.10mm, 0.00mm)
        }
    }
}

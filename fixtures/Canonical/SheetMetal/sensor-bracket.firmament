Profile blankProfile = Rect2 { center: [(70mm) / 2, (45mm) / 2]; size: [70mm, 45mm] }

SheetMetal SensorBracket {
    thickness: 1.5mm;
    material: "5052-H32 Aluminum";
    kFactor: 0.42;
    base: blankProfile;
    Flange Upright {
        from: Base.Rear;
        length: 25mm;
        angle: 90deg;
        insideRadius: 2mm;
        direction: Up;
    }
    Hole Mount {
        on: Base;
        center: Point2(35mm, 18mm);
        diameter: 6mm;
    }
}

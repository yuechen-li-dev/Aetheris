<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Invoked through dotnet or the main CLI; do not transitively ship an OS apphost. -->
    <UseAppHost Condition="'$(SelfContained)' != 'true'">false</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aetheris.Continuum\Aetheris.Continuum.csproj" />
    <ProjectReference Include="..\Aetheris.Kernel.Firmament\Aetheris.Kernel.Firmament.csproj" />
  </ItemGroup>
</Project>

Model Result {
    units: mm

    Enum SizeChoice { Compact Standard }
    Feature Bore(choice: SizeChoice) -> Hole<Shaft> {
        return Hole<Shaft> { on: +Z center: Point2(0mm, 0mm) diameter: Match choice {
            Compact => 6mm
        } end: ThroughAll }
    }
    Box Stock { size: [40mm, 20mm, 5mm] }
    Modify Stock {}
}

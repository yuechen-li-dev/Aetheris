Concept Struct RectangleLayout On XY {
    Point2 SouthWest { Position: [-10mm, -5mm] }
    Point2 SouthEast { Position: [10mm, -5mm] }
    Point2 NorthEast { Position: [10mm, 5mm] }
    Point2 NorthWest { Position: [-10mm, 5mm] }
    Line2 South { From: SouthWest; To: SouthEast }
    Line2 East { From: SouthEast; To: NorthEast }
    Line2 North { From: NorthEast; To: NorthWest }
    Line2 West { From: NorthWest; To: SouthWest }
}

Profile Bracket Using RectangleLayout {
    Loop Outer {
        South
        |> East
        |> North
        |> West
        |> Close
    }
}

Struct Body { Extrude Bracket { Profile: Bracket; From: 0mm; To: 8mm } }
Modify Body {
    EdgeFinish TopPerimeter {
        Target: Bracket.Outer
        On: Top
        Kind: Chamfer
        Distance: 1mm
    }
}

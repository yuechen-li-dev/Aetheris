Model CountersinkHole {
    units: mm

    Box Base { size: [70mm, 45mm, 18mm] }

    Modify Base {
        Hole<Countersink> Mount {
            on: +Z
            center: Point2(0mm, 0mm)
            diameter: 6mm
            countersinkDiameter: 14mm
            countersinkAngle: 90deg
            end: ThroughAll
        }
    }
}

Model RectangularBoss {
    Units: mm

    Concept Struct Layout On XY {
        Rect2 Stock { Center: [0mm, 0mm]; Size: [50mm, 32mm] }
        Rect2 Pad { Center: [0mm, 0mm]; Size: [20mm, 12mm] }
    }
    Profile BaseProfile Using Layout { Loop Outer {
     Stock.Bottom
     |> Stock.Right
     |> Stock.Top
     |> Stock.Left
     |> Close
 } }
    Profile BossProfile Using Layout { Loop Outer {
     Pad.Bottom
     |> Pad.Right
     |> Pad.Top
     |> Pad.Left
     |> Close
 } }

    Struct BracketBlock {
        Compose Body {
            Base Stock { Profile: BaseProfile; From: 0mm; To: 8mm; Role: Stock }
            Boss MountingPad { On: Top; Profile: BossProfile; Height: 5mm }
        }
    }
}

Model MiterPair {
    units: mm
    MiterGear A { Module: 1.5mm Teeth: 20 PressureAngle: 20deg FaceWidth: 8mm BoreDiameter: 8mm PitchConeAngle: 45deg }
    MiterGear B { Module: 1.5mm Teeth: 20 PressureAngle: 20deg FaceWidth: 8mm BoreDiameter: 8mm PitchConeAngle: 45deg Phase: 9deg }
    Interface<Gear> Mesh { a: A b: B ShaftAngle: 90deg }
}

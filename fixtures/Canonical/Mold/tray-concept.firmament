// A rounded tray at its first mold review: vertical walls, so every wall reports insufficient draft,
// and nothing else. The parting plane sits at the rim; the core forms the inside.
Model RoundedTray {
  units: mm
  Profile outline = RoundedRect2 { center: [0mm, 0mm]; size: [120mm, 80mm]; radius: 12mm }
  Compose<Hollow> body {
    wallThickness: 2mm
    openings: [Top]
    Base stock { profile: outline; from: 0mm; to: 24mm; role: Stock }
  }
}

Mold TrayTool {
  part: RoundedTray
  material: ABS
  stage: Concept
  pull: +Z
  parting: Plane { at: face(+Z) }
  cosmetic: [face(-Z)]
}

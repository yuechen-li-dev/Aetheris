Model SurfX3bAddSectionChainGrip {
  Units: mm

  SectionChain GripChain {
    StartTermination: Open
    EndTermination: Cap
    Station Attach { Origin: [0mm, 0mm, 10mm]
      Size: [40mm, 20mm] }
    Station Neck { Origin: [10mm, 0mm, 10mm]
      Size: [34mm, 18mm] }
    Station PalmFront { Origin: [22mm, 0mm, 10mm]
      Size: [30mm, 16mm] }
    Station PalmRear { Origin: [36mm, 0mm, 10mm]
      Size: [24mm, 14mm] }
    Station Tail { Origin: [48mm, 0mm, 10mm]
      Size: [14mm, 10mm] }
  }

  BodyState Base {
    Size: [80mm, 40mm, 20mm]
    Hole MountA { Center: [-25mm, -12mm]
      Diameter: 4mm }
    Hole MountB { Center: [25mm, 12mm]
      Diameter: 4mm }
  }

  SculptState GripAdded {
    Input: Base
    AddSectionChain Grip {
      Chain: GripChain
      Support: HousingSideEast
      Terminal: Attach
      InfluenceEnvelope: [40mm, -20mm, 0mm, 100mm, 20mm, 20mm]
    }
    MayModify: [HousingSideEast]
    Preserve: [BottomMountingInterface, MountingHolePattern]
    Require: [ClosedManifold, OrientationConsistency, NoSelfIntersection]
  }

  Output: GripAdded
}

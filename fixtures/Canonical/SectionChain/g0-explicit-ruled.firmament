Model G0ExplicitRuled {
 units: mm
 Concept Struct Stations {
  D0: Plane { Origin: [0mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D1: Plane { Origin: [20mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
 }
 Construction Plane F0 { Trace: Stations.D0 }
 Construction Plane F1 { Trace: Stations.D1 }
 Path Box { start: Point2(-4mm,-3mm) heading: 0deg Line Bottom { length: 8mm } Line Right { Turn: 90deg; length: 6mm } Line Top { Turn: 90deg; length: 8mm } Close Left }
 Profile PBox from Box
 SectionChain G0ExplicitRuled {
  continuity: G0
  Transition: Ruled
  Section A {
   frame: F0
   profile: PBox
   seam: Bottom
  }
  Section B {
   frame: F1
   profile: PBox
   seam: Bottom
  }
  start: Cap
  end: Cap
 }
}

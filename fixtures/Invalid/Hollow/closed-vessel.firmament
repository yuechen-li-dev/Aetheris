// Without an opening the cavity is a sealed void, which is not built yet.
Model RoundedTray {
  units: mm
  Profile outline = RoundedRect2 { center: [0mm, 0mm]; size: [120mm, 80mm]; radius: 12mm }
  Compose<Hollow> body {
    wallThickness: 2mm
    Base stock { profile: outline; from: 0mm; to: 24mm; role: Stock }
  }
}

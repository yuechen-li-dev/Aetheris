model SideHoleZAxisV2 {
    units mm

    solid base: Box {
        size: [10, 8, 6]
    }

    modify base {
        region sideHole on face(+Z) {
            cut Cylinder {
                radius: 1
                center: [1, 0]
                through: face(-Z)
            }
        }
    }
}

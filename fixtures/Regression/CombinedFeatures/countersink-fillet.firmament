Model CountersinkFinish {
    units: mm
    Box Base { size: [60mm, 40mm, 10mm] }
    Modify Base {
        Hole<Countersink> Mount {
            on: +Z
            center: Point2(0mm, 0mm)
            diameter: 6mm
            countersinkDiameter: 12mm
            countersinkAngle: 90deg
            end: ThroughAll
        }
        EdgeFinish Finish { face: +Z; target: Boundary; kind: Fillet; radius: 1mm }
    }
}

Model CounterboreHole {
    units: mm

    Box Base { size: [70mm, 45mm, 18mm] }

    Modify Base {
        Hole<Counterbore> Mount {
            on: +Z
            center: Point2(0mm, 0mm)
            diameter: 6mm
            counterboreDiameter: 12mm
            counterboreDepth: 5mm
            end: ThroughAll
        }
    }
}

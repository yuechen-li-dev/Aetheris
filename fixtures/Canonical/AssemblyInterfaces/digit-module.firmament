// Reusable leaf definition. Internal shaft/bearing details are private.
Subassembly DigitModule {
    <Assembly DigitModule>
        <Part Shaft = DigitShaft>
            Semantic Joint {
                Axis Axis = [0,0,0] -> [0,0,1];
                Plane Seat = [0,0,0] normal [0,0,1];
                Point Locator = [0,0,0];
            }
        </Part>
        <Part Bearing = DigitBearing>
            Semantic Joint {
                Axis Axis = [0,0,0] -> [0,0,1];
                Plane Seat = [0,0,0] normal [0,0,1];
                Point Locator = [0,0,0];
            }
        </Part>
    </Assembly>

    anchor: DigitModule.Bearing.Joint;

    Interface<Revolute> ShaftBearing {
        a: DigitModule.Shaft.Joint;
        b: DigitModule.Bearing.Joint;
    }

    expose {
        Semantic Input = Bearing.Joint;
        Semantic Output = Shaft.Joint;
    }
}

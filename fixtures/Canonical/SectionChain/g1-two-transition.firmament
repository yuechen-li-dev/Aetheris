Model G1TwoTransition {
 Units: mm
 Concept Struct Stations {
  D0: Plane { Origin: [0mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D1: Plane { Origin: [20mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D2: Plane { Origin: [55mm,2mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
 }
 Construction Plane F0 { Trace: Stations.D0 }
 Construction Plane F1 { Trace: Stations.D1 }
 Construction Plane F2 { Trace: Stations.D2 }
 Concept Path Small { Start: Point2(-4mm,-3mm) Heading: 0deg Line Bottom { Length: 8mm } Line Right { Turn: 90deg; Length: 6mm } Line Top { Turn: 90deg; Length: 8mm } Close Left }
 Concept Path Large { Start: Point2(-10mm,-7mm) Heading: 0deg Line Bottom { Length: 20mm } Line Right { Turn: 90deg; Length: 14mm } Line Top { Turn: 90deg; Length: 20mm } Close Left }
 Profile PSmall From Small
 Profile PLarge From Large
 SectionChain G1TwoTransition {
  Continuity: G1
  Section A {
   Frame: F0
   Profile: PSmall
   Seam: Bottom
  }
  Section B {
   Frame: F1
   Profile: PLarge
   Seam: Bottom
  }
  Section C {
   Frame: F2
   Profile: PSmall
   Seam: Bottom
  }
  Start: Cap
  End: Cap
 }
}

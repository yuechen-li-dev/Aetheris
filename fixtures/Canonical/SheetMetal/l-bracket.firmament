Profile mainProfile = Rect2 { center: [(80mm) / 2, (40mm) / 2]; size: [80mm, 40mm] }

// Minimal source-independent single-bend bracket.
SheetMetal LBracket {
    thickness: 1.5mm;
    material: "5052-H32 Aluminum";
    kFactor: 0.42;
    Base Main { profile: mainProfile; }
    Flange Wall {
        from: Main.Left;
        length: 25mm;
        angle: 90deg;
        insideRadius: 2mm;
        direction: Up;
    }
}

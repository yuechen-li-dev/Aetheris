// M10 independent reconstruction of NIST CTC-03.
// Construction reads no STEP, recovery provider, face ID, edge ID, or recovered polygon.
// Dimensions below are source-derived unless explicitly described as a flattening policy.
Record CtcServiceRecessSpec {
    Center: Length
    Lead: Length
    Run: Length
    Depth: Length
    AttachmentInset: Length
    AttachmentSpan: Length
}

Template < P: CtcServiceRecessSpec, Owner: ProfilePath >
ProfileDelta CtcServiceRecess {
    On: Owner;
    Anchor: CenteredAt P.Center;
    Side: Inward;
    Level Carrier { Offset: 0mm; }
    Level Deep { Offset: P.Depth; }
    Level Attachment { Offset: P.AttachmentInset; }
    Transition LeadIn { Kind: Diagonal; Run: P.Lead; To: Deep; }
    Span LeftRecessRun { Run: P.Run; At: Deep; }
    Transition RiseToAttachment { Kind: Step; To: Attachment; }
    Span AttachmentLand { Run: P.AttachmentSpan; At: Attachment; Expose: ServiceFlangeAttachment; Capabilities: [FlangeAttachable, BendAttachable, FeatureAttachable, StableSemanticIdentity]; }
    Transition FallFromAttachment { Kind: Step; To: Deep; }
    Span RightRecessRun { Run: P.Run; At: Deep; }
    Transition LeadOut { Kind: Diagonal; Run: P.Lead; To: Carrier; }
}

Static CtcServiceProfile: CtcServiceRecessSpec = CtcServiceRecessSpec {
    Center: 186.5376mm;
    Lead: 15.24mm;
    Run: 63.5mm;
    Depth: 15.24mm;
    AttachmentInset: 2.6416mm;
    AttachmentSpan: 127mm;
}

Record RoundedTabSpec { Center: Length Radius: Length Crown: Length Extension: Length }
Template < P: RoundedTabSpec, Owner: ProfilePath >
ProfileDelta RoundedTab {
    On: Owner;
    Anchor: CenteredAt P.Center;
    Side: Outward;
    Level Carrier { Offset: 0mm; }
    Level Extended { Offset: P.Extension; }
    Transition EnterRound { Kind: Round; Run: P.Radius; To: Extended; Radius: P.Radius; }
    Span Crown { Run: P.Crown; At: Extended; }
    Transition ExitRound { Kind: Round; Run: P.Radius; To: Carrier; Radius: P.Radius; }
}
Static ServiceConnectorSpec: RoundedTabSpec = RoundedTabSpec { Center: 63.5mm; Radius: 12.7mm; Crown: 101.6mm; Extension: 12.7mm; }

Record TwoRoundRecessSpec { Center: Length Radius: Length Floor: Length Shoulder: Length Depth: Length }
Template < P: TwoRoundRecessSpec, Owner: ProfilePath >
ProfileDelta TwoRoundRecess {
    On: Owner;
    Anchor: CenteredAt P.Center;
    Side: Inward;
    Level Carrier { Offset: 0mm; }
    Level Shoulder { Offset: P.Shoulder; }
    Level Deep { Offset: P.Depth; }
    Transition EnterShoulder { Kind: Step; To: Shoulder; }
    Transition EnterRound { Kind: Round; Run: P.Radius; To: Deep; Radius: P.Radius; Concave: true; }
    Span Floor { Run: P.Floor; At: Deep; }
    Transition ExitRound { Kind: Round; Run: P.Radius; To: Shoulder; Radius: P.Radius; Concave: true; }
    Transition ExitShoulder { Kind: Step; To: Carrier; }
}
Static RearConnectorSpec: TwoRoundRecessSpec = TwoRoundRecessSpec { Center: 120.65mm; Radius: 6.35mm; Floor: 114.3mm; Shoulder: 25.4mm; Depth: 31.75mm; }

Record FourRoundRecessSpec { Center: Length Radius: Length Floor: Length OuterShoulder: Length InnerShoulder: Length Depth: Length }
Template < P: FourRoundRecessSpec, Owner: ProfilePath >
ProfileDelta FourRoundRecess {
    On: Owner;
    Anchor: CenteredAt P.Center;
    Side: Inward;
    Level Carrier { Offset: 0mm; }
    Level OuterShoulder { Offset: P.OuterShoulder; }
    Level InnerShoulder { Offset: P.InnerShoulder; }
    Level Deep { Offset: P.Depth; }
    Transition EnterOuterRound { Kind: Round; Run: P.Radius; To: OuterShoulder; Radius: P.Radius; }
    Transition EnterShoulder { Kind: Step; To: InnerShoulder; }
    Transition EnterInnerRound { Kind: Round; Run: P.Radius; To: Deep; Radius: P.Radius; Concave: true; }
    Span Floor { Run: P.Floor; At: Deep; }
    Transition ExitInnerRound { Kind: Round; Run: P.Radius; To: InnerShoulder; Radius: P.Radius; Concave: true; }
    Transition ExitShoulder { Kind: Step; To: OuterShoulder; }
    Transition ExitOuterRound { Kind: Round; Run: P.Radius; To: Carrier; Radius: P.Radius; }
}
Static FrontConnectorSpec: FourRoundRecessSpec = FourRoundRecessSpec { Center: 120.65mm; Radius: 6.35mm; Floor: 114.3mm; OuterShoulder: 6.35mm; InnerShoulder: 25.4mm; Depth: 31.75mm; }

Concept Ctc03ManufacturedIntent {
    MainDeck: SheetRegion
    BaseFastenerPattern: SheetPattern
    VentSlots: SheetPattern
    RearMountHoles: SheetPattern
    FrontMountHoles: SheetPattern
    ServiceHole: SheetPattern
    ServiceInnerHoles: SheetPattern
    ServiceOuterHoles: SheetPattern
    Flat: FlatPattern
}

Concept Struct Ctc03Layout {
    // One user-programmed semantic construction owns the complete right-wall
    // recess and exposes its central land as the child-flange attachment path.
    ProfileDelta RightWallServiceProfile = CtcServiceRecess < P: CtcServiceProfile, Owner: RightWall.Outer >

    // Named local workpoints isolate measured formed coordinates from feature generation.
    Datum RearMountCenter { On: RearMountingFlange; At: (120.65mm, 25.40254mm); }
    Datum FrontMountCenter { On: FrontMountingFlange; At: (120.65mm, 24.43226mm); }
    Datum ServiceHoleCenter { On: AngledServiceFlange; At: (63.5mm, 30.735796052mm); }

    // Source contour: the 127 mm partial flange grows a centered 101.6 mm tab
    // through two tangent R12.7 transitions rather than sharp shoulders.
    ProfileDelta ServiceConnectorProfile = RoundedTab < P: ServiceConnectorSpec, Owner: AngledServiceFlange.Outer >

    // Source free-edge programs. These retain the vertical shoulders while
    // expressing the six tangent R6.35 transitions visible in the recovered blank.
    ProfileDelta RearConnectorRelief = TwoRoundRecess < P: RearConnectorSpec, Owner: RearMountingFlange.Outer >

    ProfileDelta FrontConnectorRelief = FourRoundRecess < P: FrontConnectorSpec, Owner: FrontMountingFlange.Outer >

    // Cross-edge region-profile corners. Each operation consumes the named
    // side-edge endpoint and the adjacent Outer-edge endpoint as one feature.
    CornerProfile FrontWall.RootEnd   { NotchCorner RearEndStep { SetbackA: 8.89mm; SetbackB: 12.57046mm; } }
    CornerProfile FrontWall.RootStart { NotchCorner FrontEndStep { SetbackA: 12.57046mm; SetbackB: 8.89mm; } }
    CornerProfile RearWall.RootEnd    { NotchCorner FrontEndStep { SetbackA: 8.89mm; SetbackB: 12.57046mm; } }
    CornerProfile RearWall.RootStart  { NotchCorner RearEndStep { SetbackA: 12.57046mm; SetbackB: 8.89mm; } }

    CornerProfile LeftWall.OuterStart { Chamfer RearEndTaper { Setback: 25.4mm; } }
    CornerProfile LeftWall.OuterEnd   { Chamfer FrontEndTaper { Setback: 25.4mm; } }
    CornerProfile RightWall.OuterStart { Round RearEndRound { Radius: 12.7mm; } }
    CornerProfile RightWall.OuterEnd   { Round FrontEndRound { Radius: 12.7mm; } }

    CornerProfile FrontMountingFlange.OuterStart { Chamfer RightEndChamfer { Setback: 12.7mm; } }
    CornerProfile FrontMountingFlange.OuterEnd   { Chamfer LeftEndChamfer { Setback: 12.7mm; } }
    CornerProfile RearMountingFlange.OuterStart  { Chamfer LeftEndChamfer { Setback: 12.7mm; } }
    CornerProfile RearMountingFlange.OuterEnd    { Chamfer RightEndChamfer { Setback: 12.7mm; } }

    // Four source-PMI Ø0.625 in holes at equal 1.75 in pitch.
    Pattern BaseFastenerPattern {
        On: MainDeck;
        Feature: Circle { Diameter: 15.875mm; };
        Center: MainDeck.Center + (82.55mm, -78.78826mm);
        Count: 4;
        Pitch: (0mm, 44.45mm);
    }

    Pattern LargeOpeningTwoInch {
        On: MainDeck;
        Feature: Circle { Diameter: 50.8mm; };
        Center: MainDeck.Center + (-31.2674mm, 114.68354mm);
        Count: 1;
        Pitch: (0mm, 0mm);
    }

    Pattern LargeOpeningOnePointFiveInch {
        On: MainDeck;
        Feature: Circle { Diameter: 38.1mm; };
        Center: MainDeck.Center + (57.6326mm, 89.28354mm);
        Count: 1;
        Pitch: (0mm, 0mm);
    }

    Pattern VentSlots {
        On: MainDeck;
        Feature: Slot { Length: 19.05mm; Width: 88.9mm; };
        Center: MainDeck.Center + (-37.6174mm, -75.71486mm);
        Count: 2;
        Pitch: (63.5mm, 0mm);
    }

    Pattern RearMountHoles {
        On: RearMountingFlange;
        Feature: Circle { Diameter: 11.1252mm; };
        Center: RearMountCenter;
        Count: 2;
        Pitch: (203.2mm, 0mm);
    }

    Pattern FrontMountHoles {
        On: FrontMountingFlange;
        Feature: Circle { Diameter: 11.1252mm; };
        Center: FrontMountCenter;
        Count: 2;
        Pitch: (203.2mm, 0mm);
    }

    Pattern ServiceHole {
        On: AngledServiceFlange;
        Feature: Circle { Diameter: 27.051mm; };
        Center: ServiceHoleCenter;
        Count: 1;
        Pitch: (0mm, 0mm);
    }

    Pattern ServiceInnerHoles {
        On: AngledServiceFlange;
        Feature: Circle { Diameter: 4.7625mm; };
        Center: AngledServiceFlange.Center + (0mm, -7.491203948mm);
        Count: 2;
        Pitch: (38.1mm, 0mm);
    }

    Pattern ServiceOuterHoles {
        On: AngledServiceFlange;
        Feature: Circle { Diameter: 4.7625mm; };
        Center: AngledServiceFlange.Center + (0mm, 24.258796052mm);
        Count: 2;
        Pitch: (38.1mm, 0mm);
    }
}

SheetMetal Ctc03 : Ctc03ManufacturedIntent {
    Intent: Reconstructed;
    Thickness: 1.905mm;
    KFactor: 0.5;
    Material: "0.075 in nominal sheet";

    Base MainDeck {
        Profile: Rectangle { Width: 241.3mm; Height: 368.3mm; };
        Origin: (-241.3mm, 58.08726mm, 76.2mm);
    }

    // The source front/rear bend strips terminate 8.89 mm before both side corners.
    // These four explicit trims remove the two front and two rear rectangular tabs.
    Flange FrontWall { From: MainDeck.Front; Height: 61.59254mm; Angle: 90deg; Radius: 6.35mm; Direction: Down; StartTermination: Trimmed; StartTerminationSetback: 8.89mm; EndTermination: Trimmed; EndTerminationSetback: 8.89mm; }
    Flange RearWall  { From: MainDeck.Rear;  Height: 61.59254mm; Angle: 90deg; Radius: 6.35mm; Direction: Down; StartTermination: Trimmed; StartTerminationSetback: 8.89mm; EndTermination: Trimmed; EndTerminationSetback: 8.89mm; }
    Flange LeftWall  { From: MainDeck.Left;  Height: 44.45mm;  Angle: 90deg; Radius: 6.35mm; Direction: Up; }
    Flange RightWall { From: MainDeck.Right; Height: 31.75254mm; Angle: 90deg; Radius: 6.35mm; Direction: Up; }

    Flange FrontMountingFlange { From: FrontWall.Outer; Length: 43.47972mm; Angle: 90deg; Radius: 6.35mm; Direction: Up; }
    Flange RearMountingFlange  { From: RearWall.Outer;  Length: 44.45mm;    Angle: 90deg; Radius: 6.35mm; Direction: Up; }
    Flange AngledServiceFlange { From: RightWall.ServiceFlangeAttachment; Length: 48.514mm; Angle: 45deg; Radius: 6.35mm; Direction: Down; }
}

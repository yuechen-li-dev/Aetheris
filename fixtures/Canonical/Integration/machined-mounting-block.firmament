Model MachinedMountingBlock {
    Units: mm

    Concept Struct Layout On XY {
        Rect2 Stock { Center: [0mm, 0mm]; Size: [70mm, 44mm] }
        Rect2 BossPad { Center: [-16mm, 0mm]; Size: [14mm, 14mm] }
        Rect2 Recess { Center: [10mm, 0mm]; Size: [20mm, 16mm] }
    }

    Profile BaseProfile Using Layout { Loop Outer {
     Stock.Bottom
     |> Stock.Right
     |> Stock.Top
     |> Stock.Left
     |> Close
 } }
    Profile BossProfile Using Layout { Loop Outer {
     BossPad.Bottom
     |> BossPad.Right
     |> BossPad.Top
     |> BossPad.Left
     |> Close
 } }
    Profile PocketProfile Using Layout { Loop Outer {
     Recess.Bottom
     |> Recess.Right
     |> Recess.Top
     |> Recess.Left
     |> Close
 } }

    Struct MountingBlock {
        Compose Body {
            Base Stock { Profile: BaseProfile; From: 0mm; To: 12mm; Role: Stock }
            Boss ConnectorBoss { On: Top; Profile: BossProfile; Height: 6mm }
            Pocket ElectronicsRecess { On: Top; Profile: PocketProfile; Depth: 4mm; MinimumFloorThickness: 3mm }
            Hole<Shaft> ConnectorBore { On: +Z; Center: [-16mm, 0mm]; Diameter: 6mm; End: ThroughAll; Role: Connector }
            Hole<Counterbore> MountNorth {
                On: +Z
                Center: [26mm, 13mm]
                Diameter: 6mm
                CounterboreDiameter: 11mm
                CounterboreDepth: 3mm
                End: ThroughAll
                Role: MountingHole
            }
            Hole<Counterbore> MountSouth {
                On: +Z
                Center: [26mm, -13mm]
                Diameter: 6mm
                CounterboreDiameter: 11mm
                CounterboreDepth: 3mm
                End: ThroughAll
                Role: MountingHole
            }
        }
    }

    Modify Body {
        EdgeFinish PerimeterBreak {
            Target: BaseProfile.Outer
            On: Top
            Kind: Chamfer
            Distance: 1mm
        }
    }

    Pmi {
        Datum A { Target: face(+Z) }
        HoleDiameter ConnectorDiameter {
            Target: ConnectorBore
            Value: 6mm
            Tolerance: PlusMinus(0.05mm, 0.02mm)
            DatumRefs: [A]
        }
        HoleDiameter MountNorthDiameter {
            Target: MountNorth
            Value: 6mm
            Tolerance: PlusMinus(0.10mm, 0.00mm)
            DatumRefs: [A]
        }
    }
}

Model CanonicalWireFormPaperclip {
    Units: mm
    WireForm Paperclip {
        Diameter: 1mm
        Material: Standard.Materials.StainlessSteel.304_Annealed
        StartFrame { Origin: [8mm, 0mm, 0mm]; Tangent: [0, 1, 0]; Up: [0, 0, 1] }
        Straight InnerRight { Length: 14mm }
        Bend InnerTop { Radius: 3mm; Angle: 180deg; Plane: Up }
        Straight InnerLeft { Length: 14mm }
        Bend LowerReturn { Radius: 4mm; Angle: 180deg; Plane: Up }
        Straight OuterRight { Length: 15mm }
        Bend OuterTop { Radius: 5mm; Angle: 180deg; Plane: Up }
        Straight OuterLeft { Length: 15mm }
    }
}

Model InvalidPaperclipPolicy {
    Units: mm
    Record PaperclipPolicy {
        WireDiameter: Length
        OuterLegLength: Length
        InnerLegLength: Length
        OuterBendRadius: Length
        InnerBendRadius: Length
        Material: String
    }
    Static Invalid: PaperclipPolicy = PaperclipPolicy {
        WireDiameter: 1mm
        OuterLegLength: 15mm
        InnerLegLength: 14mm
        OuterBendRadius: 3mm
        InnerBendRadius: 5mm
        Material: "Standard.Materials.StainlessSteel.304_Annealed"
    }
    Template < P: PaperclipPolicy >
    Struct PaperclipTemplate {
        Require OuterBendExceedsInnerBend => P.OuterBendRadius > P.InnerBendRadius
        Concept Path Centerline {
            Start: Point2(0mm, 0mm)
            Heading: 0deg
            Line Stem { Length: P.OuterLegLength }
        }
        Sweep Wire {
            Path: Centerline
            Diameter: P.WireDiameter
            Material: P.Material
        }
    }
    Struct Broken = PaperclipTemplate < P: Invalid >
}

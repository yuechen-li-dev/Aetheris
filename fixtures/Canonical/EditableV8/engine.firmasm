include "cylinder-config";
include "rest-configurations";
include "interfaces";
include "design";

Inventory Record Units {
  cylinder: Subassembly = Firmament("assemblies/cylinder").CylinderUnit
  crankshaft: Subassembly = Firmament("assemblies/crankshaft").Crankshaft
  crankcase: Subassembly = Firmament("assemblies/crankcase").Crankcase
  camRight: Subassembly = Firmament("assemblies/cam-right").CamRight
  camLeft: Subassembly = Firmament("assemblies/cam-left").CamLeft
}

Concept Struct EngineLayout {
  DatumFrame Shaft { from: World; translateLocal: [0mm,0mm,d.cylinderSpacing / 2] }
  DatumFrame RightBank { from: World; rotateLocal: { axis: Z; angle: -45deg } }
  DatumFrame LeftBank { from: World; rotateLocal: { axis: Z; angle: 45deg } }
  DatumFrame RightCam {
    from: RightBank
    translateLocal: [0mm,d.camHeight,2 * d.cylinderSpacing]
    rotateLocal: { axis: Z; angle: 45deg }
  }
  DatumFrame LeftCam {
    from: LeftBank
    translateLocal: [0mm,d.camHeight,2 * d.cylinderSpacing]
    rotateLocal: { axis: Z; angle: -45deg }
  }
}
// Product ownership is separate from the prescribed analytical motion.
Assembly EditableV8 {
  <Assembly EditableV8>
    Pattern Cylinders over cylinderConfigs {
      config => {
        <Assembly Cylinder = Units.cylinder<config: config>></Assembly>
        Concept Struct Installation {
          Axis Mount { origin: [0mm,0mm,config.z]; direction: [0,0,1]; reference: [config.bankCos,-config.bankSin,0]; }
        }
        Interface<Fixed> CylinderSeat { datum: Installation.Mount; members: [Cylinder.Mount]; }
        Mate Install: CylinderSeat { member: Cylinder.Mount; at: 0mm; clocking: 0deg; }
        Mate RodJournal: JournalFit { Journal: config.journal; Bore: Cylinder.RodBore; }
      }
    }
    <Assembly Crankshaft = Units.crankshaft></Assembly>
    <Assembly Crankcase = Units.crankcase></Assembly>
    <Assembly CamRight = Units.camRight></Assembly>
    <Assembly CamLeft = Units.camLeft></Assembly>
  </Assembly>
  Interface<Fixed> ShaftLayout { datum: EngineLayout.Shaft; members: [EditableV8.Crankshaft.Mount, EditableV8.Crankcase.Mount]; }
  Mate InstallCrankshaft: ShaftLayout { member: EditableV8.Crankshaft.Mount; at: 0mm; clocking: 0deg; }
  Mate InstallCrankcase: ShaftLayout { member: EditableV8.Crankcase.Mount; at: 0mm; clocking: 0deg; }
  Interface<Fixed> RightCamLayout { datum: EngineLayout.RightCam; members: [EditableV8.CamRight.Mount]; }
  Mate InstallRightCam: RightCamLayout { member: EditableV8.CamRight.Mount; at: 0mm; clocking: 0deg; }
  Interface<Fixed> LeftCamLayout { datum: EngineLayout.LeftCam; members: [EditableV8.CamLeft.Mount]; }
  Mate InstallLeftCam: LeftCamLayout { member: EditableV8.CamLeft.Mount; at: 0mm; clocking: 0deg; }
  anchor: EditableV8;
}

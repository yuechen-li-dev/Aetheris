Struct CylindricalGrid24 {
  Cylinder<Hollow> Body {
    Radius: 24mm
    Height: 60mm
    WallThickness: 0.8mm
    Openings: [Top]
  }
  Modify Body {
    Perforation Vents {
      on: OuterWall
      diameter: 5mm
      layout: CylindricalGrid
      pitch: 14mm
      circumferentialPitch: 18.5mm
      marginTop: 13mm
      marginBottom: 13mm
      minimumLigament: 2mm
      startAngle: 0deg
    }
  }
}

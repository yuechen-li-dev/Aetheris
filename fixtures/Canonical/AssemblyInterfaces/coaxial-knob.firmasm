include "GuitarX0/materials.firmament";
include "GuitarX0/hardware-definitions.firmament";
include "GuitarX0/knob.firmament";
// One Concept spindle drives the complete rigid knob, along world X.
Concept Struct ControlLayout {
 Axis VolumeAxis { origin: [3mm,4mm,5mm]; direction: [2,0,0]; reference: [0,3,1]; }
}
Assembly Controls {
 <Assembly Controls><Assembly VolumeKnob = ControlKnob></Assembly></Assembly>
 anchor: Controls;
 Interface<Revolute> VolumeControl { datum: ControlLayout.VolumeAxis; members: [Controls.VolumeKnob.Spindle]; }
 Mate VolumeRotation: VolumeControl { member: Controls.VolumeKnob.Spindle; at: 7mm; clocking: 30deg; }
}

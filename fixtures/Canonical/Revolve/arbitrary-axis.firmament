schema Mechanical

Model ArbitraryAxisTurn {
    units: mm
    Axis Tilted { origin: [3mm, 4mm, 5mm]; direction: [1, 1, 0] }
    Concept Struct Supports { Datum: Plane { origin: [3mm,4mm,5mm]; normal: [1,-1,0]; up: [0,0,1] } }
    Construction Plane SectionFrame { Trace: Supports.Datum }
    Rect2 Section { center: [0mm, 15mm]; size: [20mm, 10mm] }
    Profile SectionProfile using SectionFrame { Loop Outer { Section |> TraceLoop } }
    Revolve TiltedRing { Profile: SectionProfile; About: Tilted; Angle: half }
}

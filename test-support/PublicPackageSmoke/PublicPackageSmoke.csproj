<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AetherisReleaseVersion Condition="'$(AetherisReleaseVersion)' == ''">2.0.0</AetherisReleaseVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aetheris.Kernel.Core" Version="$(AetherisReleaseVersion)" />
    <PackageReference Include="Aetheris.Kernel.Firmament" Version="$(AetherisReleaseVersion)" />
    <PackageReference Include="Aetheris.Kernel.StandardLibrary" Version="$(AetherisReleaseVersion)" />
    <PackageReference Include="Aetheris.Forge.Host" Version="$(AetherisReleaseVersion)" />
    <PackageReference Include="Aetheris.Forge.KernelSDK" Version="$(AetherisReleaseVersion)" />
  </ItemGroup>
</Project>

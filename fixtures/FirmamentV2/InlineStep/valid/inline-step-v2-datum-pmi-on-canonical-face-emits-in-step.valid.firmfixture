// fixture-id: inline-step-v2-datum-pmi-on-canonical-face-emits-in-step
// case: inline-step-v2-datum-pmi-on-canonical-face-emits-in-step
// category: InlineStep
// syntax-version: FirmamentV2
// validity: valid
// implementation: parser-backed
// expected: valid
// tier: inline-step
// expected-stage: step-verified
// current-stage: step-verified
// feature-area: inline-step-semantic-pmi
// build-command: aetheris build
// roundtrip-required: true
// expected-volume: 480
// expected-topology: faces=6, vertices=8, edges=12
// canonical-input-required: true
// semantic-pmi-required: true
// graphical-pmi-required: false
// input-step: ../testdata/canonical-box-10x8x6.step
// semantic-pmi-evidence: SHAPE_ASPECT('firmament-datum:A'), PROPERTY_DEFINITION('datum:A:importedPart')
// notes: INLINE-STEP-X2 attaches semantic datum PMI to canonical imported face #40 through Step242Exporter; no graphical PMI.
model InlineStepDatumPmiOnCanonicalFace {
    units mm

    solid importedPart: InlineStep {
        path: "../testdata/canonical-box-10x8x6.step"
    }

    pmi {
        datum A {
            target: importedPart.face("#40")
        }
    }
}

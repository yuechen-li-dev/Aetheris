Profile blankProfile = Rect2 { center: [(100mm) / 2, (60mm) / 2]; size: [100mm, 60mm] }

SheetMetal TwoHoleLBracket {
    thickness: 1.5mm;
    material: "5052-H32 Aluminum";
    kFactor: 0.42;

    base: blankProfile;

    Flange Upright {
        from: Base.Rear;
        length: 35mm;
        angle: 90deg;
        insideRadius: 2mm;
        direction: Up;
    }

    Hole MountLeft {
        on: Base;
        center: Point2(25mm, 25mm);
        diameter: 8mm;
    }

    Hole MountRight {
        on: Base;
        center: Point2(75mm, 25mm);
        diameter: 8mm;
    }
}

Profile blankProfile = Rect2 { center: [(100mm) / 2, (60mm) / 2]; size: [100mm, 60mm] }

// Minimal two-bend channel.
SheetMetal SimpleUChannel {
    thickness: 1.5mm;
    material: "5052-H32 Aluminum";
    kFactor: 0.42;

    base: blankProfile;

    Flange LeftFlange {
        from: Base.Left;
        length: 25mm;
        angle: 90deg;
        insideRadius: 2mm;
        direction: Up;
    }

    Flange RightFlange {
        from: Base.Right;
        length: 20mm;
        angle: 90deg;
        insideRadius: 2mm;
        direction: Up;
    }

    Hole MountA {
        on: Base;
        center: Point2(25mm, 30mm);
        diameter: 8mm;
    }

    Hole MountB {
        on: Base;
        center: Point2(75mm, 30mm);
        diameter: 8mm;
    }
}

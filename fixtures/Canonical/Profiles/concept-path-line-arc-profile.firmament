Model ConceptPathArc {
    units: mm
    Path RoundedCorner {
        start: Point2(0mm, 0mm)
        heading: 0deg
        Line Base { length: 40mm }
        Line Rise { Turn: 90deg; length: 20mm }
        Arc OuterFillet { Radius: 10mm; Turn: 90deg }
        Line Top { length: 30mm }
        Close Left
    }
    Profile Plate from RoundedCorner
    Struct Body { Extrude Plate { profile: Plate; from: 0mm; to: 2mm } }
}

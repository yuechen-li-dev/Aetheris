Model ProfileStraightEdgeFilletTop {
units: mm
Concept Struct RectangleLayout on XY {
    Point2 A { position: [0mm, 0mm] } Point2 B { position: [20mm, 0mm] }
    Point2 C { position: [20mm, 10mm] } Point2 D { position: [0mm, 10mm] }
    Line2 South { from: A; to: B } Line2 East { from: B; to: C }
    Line2 North { from: C; to: D } Line2 West { from: D; to: A }
}
Profile Bracket using RectangleLayout { Loop Outer {
     South
     |> East
     |> North
     |> West
     |> Close
 } }
Struct Body { Extrude Bracket { profile: Bracket; from: 0mm; to: 8mm } }
Modify Body { EdgeFinish SouthTopRound { Target: Bracket.Outer.South On: Top Kind: Fillet Radius: 2mm EndClearance: 3mm } }
Assert Volume Body {
    Expected: 1587.982297150257mm^3
    Tolerance: 0.01mm^3
    Note: "Independent box-minus-finite-quarter-cylinder analytic volume."
}
}

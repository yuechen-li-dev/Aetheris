Model ProfileEdgeFinishChimeraBase {
    Units: mm
    // F = 4 mm.  The eight stations are isolated by at least 8F of straight run.
    Concept Path ChimeraOutline {
        Start: Point2(0mm, 0mm)
        Heading: 0deg
        Line Bottom { Length: 420mm }
        Line RightSide { Turn: 90deg; Length: 100mm }
        Line TopLead { Turn: 90deg; Length: 20mm }
        Line ConvexSharpDrop { Turn: 90deg; Length: 40mm }
        Line ReflexSharpRun { Turn: -90deg; Length: 40mm }
        Arc ReflexSmallArc { Turn: -90deg; Radius: 2mm }
        Line ReflexSmallRise { Length: 38mm }
        // ConvexSmall (Rs < F) is intentionally a canonical-invalid policy case.
        // This release card keeps only admitted stations.
        Line BetweenSmallMedium { Turn: 90deg; Length: 42mm }
        Arc ConvexMediumArc { Turn: 90deg; Radius: 4mm }
        Line MediumDrop { Length: 32mm }
        Arc ReflexMediumArc { Turn: -90deg; Radius: 4mm }
        Line BetweenMediumLarge { Length: 40mm }
        Arc ReflexLargeArc { Turn: -90deg; Radius: 8mm }
        Line LargeRise { Length: 24mm }
        Arc ConvexLargeArc { Turn: 90deg; Radius: 8mm }
        Line TopReturn { Length: 252mm }
        Close LeftSide
    }
    Profile Chimera From ChimeraOutline
    Struct Body { Extrude Chimera { Profile: Chimera; From: 0mm; To: 24mm } }

    // A station is a source-bound chain; no BRep edge discovery is involved.
    Selection ConvexSharpStation { Target: TopBoundary Source: Chimera.ProfileSegments([TopLead, ConvexSharpDrop]) Require: ConnectedChain }
    Selection ConvexMediumStation { Target: TopBoundary Source: Chimera.ProfileSegments([BetweenSmallMedium, ConvexMediumArc, MediumDrop]) Require: ConnectedChain }
    Selection ConvexLargeStation { Target: TopBoundary Source: Chimera.ProfileSegments([LargeRise, ConvexLargeArc, TopReturn]) Require: ConnectedChain }
    Selection ReflexSharpStation { Target: TopBoundary Source: Chimera.ProfileSegments([ConvexSharpDrop, ReflexSharpRun]) Require: ConnectedChain }
    Selection ReflexSmallStation { Target: TopBoundary Source: Chimera.ProfileSegments([ReflexSharpRun, ReflexSmallArc, ReflexSmallRise]) Require: ConnectedChain }
    Selection ReflexMediumStation { Target: TopBoundary Source: Chimera.ProfileSegments([MediumDrop, ReflexMediumArc, BetweenMediumLarge]) Require: ConnectedChain }
    Selection ReflexLargeStation { Target: TopBoundary Source: Chimera.ProfileSegments([BetweenMediumLarge, ReflexLargeArc, LargeRise]) Require: ConnectedChain }

    Assert Volume Body {
        Expected: 917780.601776314mm^3
        Tolerance: 0.01mm^3
        Note: "Independent Green-theorem area (38240 + 4 - π) mm^2 times 24 mm extrusion."
    }
}

Model BearingBlock {
    Units: mm

    Enum BearingSize { BB080 BB100 BB120 }
    Record BearingStandard {
        Size: BearingSize
        Width: Length
        Height: Length
        Depth: Length
        BoreDiameter: Length
    }
    Static Table BearingStandards: BearingStandard Key: Size {
        Size: [BB080, BB100, BB120]
        Width: [80mm, 100mm, 120mm]
        Height: [50mm, 60mm, 70mm]
        Depth: [12mm, 16mm, 20mm]
        BoreDiameter: [8mm, 10mm, 12mm]
    }
    Box Base { Size: [80mm, 50mm, 12mm] }
    Modify Base {
        Hole<Shaft> Mount {
            On: +Z
            Center: Point2(0mm, 0mm)
            Diameter: 8mm
            End: ThroughAll
        }
    }
    Require MountDiameterConstraint {
        Actual: Mount.Diameter
        Expected: 8mm
        Tolerance: PlusMinus(0.05mm, 0.02mm)
    }
    Pmi {
        Datum A { Target: face(+Z) }
        HoleDiameter MountDiameter {
            From: MountDiameterConstraint
            As: HoleDiameter
            DatumRefs: [A]
        }
    }

    Record DrawingInfo {
        Company: String
        Author: String
        PartNumber: String
        Revision: Version
        Date: Date
        Description: String
        Title: String
        Material: String
    }

    Static AsterDrawingDefaults: DrawingInfo = DrawingInfo {
        Company: "Aster Works"
        Author: "CODEX"
        PartNumber: "UNASSIGNED"
        Revision: 1.0.0
        Date: 2026-08-10
        Description: "Production drawing"
        Title: "Production drawing"
        Material: "PER PRODUCT"
    }

    Static BearingBlockDrawingInfo = AsterDrawingDefaults with {
        PartNumber: "BB-080"
        Description: "Machined bearing block"
        Title: "Bearing Block Production Drawing"
        Material: "6061-T6 aluminium"
    }

    Concept Drawing MachinedPartDrawing {
        Require PrimaryView
        Require ManufacturingPmi
        Require Material
        Require DesignTable
        Require RevisionMetadata
    }

    Template < Item: Product, Metadata: DrawingInfo >
    Drawing StandardMachinedDrawing: MachinedPartDrawing {
        Source: Item
        Metadata: Metadata
        Orientation: Landscape
        Table: BearingStandards
        Notes: ["DEBURR ALL EDGES", "DIMENSIONS AND TOLERANCES COME FROM THE SEMANTIC PRODUCT MODEL"]

        View Front {
            Direction: +Z
            HiddenLines: VisibleOnly
            PMI: [MountDiameter, A]
        }
        View ISO {
            Direction: [1, 1, 1]
            Projection: Isometric
            HiddenLines: VisibleOnly
            PMI: []
        }
    }

    Drawing BearingBlockProduction = StandardMachinedDrawing<Product: BearingBlock, Metadata: BearingBlockDrawingInfo>

    Review DFM-004 {
        Target: MountDiameter;
        Status: Resolved;

        Issue DFM-004-I1 {
            Author: "Alice Chen";
            Organization: "Northstar Machining";
            Date: 2026-08-10;
            Text: "Current bore tolerance requires finish grinding.";
        }
        Proposal DFM-004-P1 {
            Author: "Alice Chen";
            Organization: "Northstar Machining";
            Date: 2026-08-10;
            Property: tolerance;
            Current: PlusMinus(0.005mm);
            Proposed: PlusMinus(0.010mm);
            Reason: "Avoid a secondary grinding operation.";
        }
        Resolution DFM-004-R1 {
            Author: "Daniel Ruiz";
            Organization: "Aster Works";
            Date: 2026-08-10;
            Text: "Accepted as a proposal for the next authoritative product revision; this review does not mutate PMI.";
        }
    }
}

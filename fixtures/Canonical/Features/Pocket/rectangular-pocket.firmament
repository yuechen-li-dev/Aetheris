// Pocket is finite. Use Hole or Slot when material must be removed through-all.
Model RectangularPocket {
    Units: mm

    Concept Struct Layout On XY {
        Rect2 Stock { Center: [0mm, 0mm]; Size: [50mm, 32mm] }
        Rect2 Recess { Center: [0mm, 0mm]; Size: [24mm, 14mm] }
    }
    Profile BaseProfile Using Layout { Loop Outer {
     Stock.Bottom
     |> Stock.Right
     |> Stock.Top
     |> Stock.Left
     |> Close
 } }
    Profile PocketProfile Using Layout { Loop Outer {
     Recess.Bottom
     |> Recess.Right
     |> Recess.Top
     |> Recess.Left
     |> Close
 } }

    Struct MachinedBlock {
        Compose Body {
            Base Stock { Profile: BaseProfile; From: 0mm; To: 10mm; Role: Stock }
            Pocket Recess { On: Top; Profile: PocketProfile; Depth: 4mm; MinimumFloorThickness: 3mm }
        }
    }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>aetheris</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aetheris</ToolCommandName>
    <PackageId>Aetheris.CLI</PackageId>
    <Authors>Yuechen Li</Authors>
    <Description>The Aetheris command-line compiler for bounded exact Firmament CAD and STEP AP242 workflows.</Description>
    <PackageTags>cad;firmament;step;ap242;geometry</PackageTags>
    <RepositoryUrl>https://github.com/yuechen-li-dev/Aetheris</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ProjectUrl>https://yuechen-li-dev.github.io/aetheris/</ProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>Aetheris.CLI.README.md</PackageReadmeFile>
    <PackageReleaseNotes>Aetheris $(Version): Firmament engineering compilation, STEP AP242, assemblies, semantic PMI, drawings, materials and bounded analysis. The core tool includes no third-party OS-native libraries; native interoperability is optional.</PackageReleaseNotes>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.dll;.exe;.json</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aetheris.Kernel.Firmament\Aetheris.Kernel.Firmament.csproj" />
    <ProjectReference Include="..\Aetheris.Kernel.Core\Aetheris.Kernel.Core.csproj" />
    <ProjectReference Include="..\Aetheris.Firmament.FrictionLab\Aetheris.Firmament.FrictionLab.csproj" GlobalPropertiesToRemove="SelfContained" />
    <ProjectReference Include="..\Aetheris.FEA\Aetheris.FEA.csproj" />
    <ProjectReference Include="..\Aetheris.Modules.BuiltIn\Aetheris.Modules.BuiltIn.csproj" />
    <ProjectReference Include="..\Aetheris.Reconstruction\Aetheris.Reconstruction.csproj" />
    <ProjectReference Include="..\Aetheris.SheetMetal\Aetheris.SheetMetal.csproj" />
    <ProjectReference Include="..\Aetheris.PlasticShell\Aetheris.PlasticShell.csproj" />
    <ProjectReference Include="..\Aetheris.Sculpture\Aetheris.Sculpture.csproj" />
    <ProjectReference Include="..\Aetheris.Drawing\Aetheris.Drawing.csproj" />
    <ProjectReference Include="..\Aetheris.Continuum\Aetheris.Continuum.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\release\Aetheris.CLI.README.md" Pack="true" PackagePath="\" Link="Aetheris.CLI.README.md" />
  </ItemGroup>
  <!-- Fail at the dependency owner, before packing or RID publishing. -->
  <Target Name="RejectThirdPartyNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_ThirdPartyNative Include="@(NativeCopyLocalItems)" Condition="!$([System.String]::Copy('%(NuGetPackageId)').StartsWith('Microsoft.NETCore.App.Runtime.'))" />
      <_ThirdPartyNative Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(AssetType)' == 'native' and !$([System.String]::Copy('%(NuGetPackageId)').StartsWith('Microsoft.NETCore.App.Runtime.'))" />
    </ItemGroup>
    <Error Condition="'@(_ThirdPartyNative)' != ''" Text="The default Aetheris CLI must not bundle third-party native assets: @(_ThirdPartyNative). Move native interoperability to an optional tool." />
  </Target>
</Project>

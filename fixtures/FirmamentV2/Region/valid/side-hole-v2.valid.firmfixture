// notes: AIR-FIRMAMENT-A2 V2 side-hole golden-path syntax design; not general side-hole support and not parser-backed.

model SideHoleExample {
    units mm

    solid base = box {
        size: [10, 8, 6]
    }

    modify base {
        region sideHole on face(+X) {
            cut cylinder {
                radius: 1
                through: face(-X)
            }
        }
    }
}

Model G1TwoTransition {
 units: mm
 Concept Struct Stations {
  D0: Plane { Origin: [0mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D1: Plane { Origin: [20mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D2: Plane { Origin: [55mm,2mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
 }
 Construction Plane F0 { Trace: Stations.D0 }
 Construction Plane F1 { Trace: Stations.D1 }
 Construction Plane F2 { Trace: Stations.D2 }
 Path Small { start: Point2(-4mm,-3mm) heading: 0deg Line Bottom { length: 8mm } Line Right { Turn: 90deg; length: 6mm } Line Top { Turn: 90deg; length: 8mm } Close Left }
 Path Large { start: Point2(-10mm,-7mm) heading: 0deg Line Bottom { length: 20mm } Line Right { Turn: 90deg; length: 14mm } Line Top { Turn: 90deg; length: 20mm } Close Left }
 Profile PSmall from Small
 Profile PLarge from Large
 SectionChain G1TwoTransition {
  continuity: G1
  Section A {
   frame: F0
   profile: PSmall
   seam: Bottom
  }
  Section B {
   frame: F1
   profile: PLarge
   seam: Bottom
  }
  Section C {
   frame: F2
   profile: PSmall
   seam: Bottom
  }
  start: Cap
  end: Cap
 }
}

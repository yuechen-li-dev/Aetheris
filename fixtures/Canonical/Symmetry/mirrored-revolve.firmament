schema Mechanical
Model MirroredRevolve {
    units: mm
    Plane MidPlane { origin: [0mm,0mm,0mm]; normal: [0,1,0]; up: [0,0,1] }
    Axis MainAxis { origin: [0mm,0mm,0mm]; direction: [0,1,0] }
    Rect2 LowerBoundary { center: [9mm, -14mm] size: [6mm, 12mm] }
    Profile LowerSection { Loop Outer { LowerBoundary |> TraceLoop } }
    Mirrored Profile UpperSection from LowerSection { across: MidPlane }
    Revolve UpperRing { Profile: UpperSection; About: MainAxis; Angle: half }
}

Model RoundedRectangleSlotPart {
    Units: mm
    Concept Struct SlotLayout On XY {
        Rect2 Stock { Center: [0mm, 0mm]; Size: [200mm, 100mm] }
    }
    Profile Plate Using SlotLayout { Loop Outer {
     Stock.Bottom As South
     |> Stock.Right As East
     |> Stock.Top As North
     |> Stock.Left As West
     |> Close
 } }
    Struct SlotFixture { Compose SlotBody {
        Base Stock { Profile: Plate; From: -10mm; To: 10mm; Role: Stock }
        Slot<RoundedRectangle> Opening { Center: Point2(0mm, 0mm); Direction: Vector2(1, 0); Length: 100mm; Width: 50mm; CornerRadius: 8mm; Extent: ThroughAll; Role: ThroughSlot }
    } }
    Selection OpeningEntry { Target: SlotEntry Source: Slot(Opening) Require: ClosedLoop }
}

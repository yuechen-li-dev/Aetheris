// fixture-id: concept-countersink-angle-range
// case: forge-cs-a3-countersink-angle-range
// category: Language
// syntax-version: FirmamentV2
// validity: invalid

model CountersinkAngleRangeInvalid {
    units mm

    let d: length = 6.0mm tol 0.05mm
    let csd: length = 10.0mm tol 0.05mm

    solid part: Box {
        size: [20, 20, 6]
    }

    feature badHole: hole<Countersink> {
        target: part.region("holeA")
        diameter: d
        countersinkDiameter: csd
        angle: 180deg
    }
}

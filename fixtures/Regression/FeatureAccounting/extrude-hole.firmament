Model ExtrudeHole {
  units: mm
  Concept Struct layout on XY {
    Rect2 outline { center: [0mm, 0mm]; size: [40mm, 30mm] }
  }
  Profile section using layout { Loop Outer { outline |> TraceLoop } }
  Extrude Body { profile: section; from: 0mm; to: 8mm }
  Modify Body {
    Hole<Shaft> Mount { on: +Z; center: Point2(0mm, 0mm); diameter: 6mm; end: ThroughAll }
  }
}

Model SculptBranchVariants {
  units: mm

  BodyState Base {
    Size: [100mm, 80mm, 20mm]
    Hole H1 { center: [-20mm, -12mm]
      diameter: 4mm }
    Hole H2 { center: [20mm, -12mm]
      diameter: 4mm }
    Hole H3 { center: [20mm, 12mm]
      diameter: 4mm }
    Hole H4 { center: [-20mm, 12mm]
      diameter: 4mm }
  }

  SculptState CrownRaised {
    Input: Base
    OffsetRegion {
      Target: HousingCrown
      Offset: 6mm
      Region: [60mm, 40mm]
      InfluenceEnvelope: [-50mm, -40mm, 20mm, 50mm, 40mm, 26mm]
      Boundary: G0
    }
    MayModify: [HousingCrown, CrownTransitionZone]
    Preserve: [BottomMountingInterface, MountingHolePattern, OuterFootprintBoundary]
    Require: [ClosedManifold, OrientationConsistency, NoSelfIntersection]
  }

  SculptState CrownHigh {
    Input: Base
    OffsetRegion {
      Target: HousingCrown
      Offset: 10mm
      Region: [60mm, 40mm]
      InfluenceEnvelope: [-50mm, -40mm, 20mm, 50mm, 40mm, 30mm]
      Boundary: G0
    }
    MayModify: [HousingCrown, CrownTransitionZone]
    Preserve: [BottomMountingInterface, MountingHolePattern, OuterFootprintBoundary]
    Require: [ClosedManifold, OrientationConsistency, NoSelfIntersection]
  }

  Output: CrownHigh
}


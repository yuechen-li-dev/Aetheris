Model HexBoltTemplateM2 {
    Units: mm

    Concept BoltConcept {
        NominalDiameter: Length
        Length: Length
        ThreadLength: Length
        ThreadDesignation: String
        Axis: Axis
    }

    Enum MetricBoltSize {
        M8
        M10
    }

    // McMaster 91180A151 is the audited M8 source. The M10 values below are
    // existing fixture/test data, retained as a provisional authoring example.
    Record HexBoltStandardRow {
        Size: MetricBoltSize
        NominalDiameter: Length
        HeadAcrossFlats: Length
        HeadHeight: Length
        TopFlatDiameter: Length
        TopChamferAngle: Angle
        UnderHeadRadius: Length
        TipChamferLength: Length
        TipDiameter: Length
    }

    Record HexBoltSpec {
        StableId: String
        Standard: HexBoltStandardRow
        Length: Length
        ThreadLength: Length
        ThreadDesignation: String
        PropertyClass: String
    }

    Static Table McMasterThreadlessHexBoltGeometry: HexBoltStandardRow Key: Size {
        Size: [M8, M10]
        NominalDiameter: [8mm, 10mm]
        HeadAcrossFlats: [13mm, 17mm]
        HeadHeight: [5.3mm, 6.4mm]
        TopFlatDiameter: [12.35mm, 16mm]
        TopChamferAngle: [25deg, 25deg]
        UnderHeadRadius: [0.2mm, 0.2mm]
        TipChamferLength: [0.9375mm, 0.9375mm]
        TipDiameter: [6.125mm, 8mm]
    }

    Static M8Standard = McMasterThreadlessHexBoltGeometry[M8]
    Static M10Standard = McMasterThreadlessHexBoltGeometry[M10]

    Static McMaster91180A151: HexBoltSpec = HexBoltSpec {
        StableId: "McMaster91180A151"
        Standard: M8Standard
        Length: 35mm
        ThreadLength: 22mm
        ThreadDesignation: "M8 x 1.25"
        PropertyClass: "8.8"
    }

    Static M10x50 = McMaster91180A151 with {
        StableId: "M10x50"
        Standard: M10Standard
        Length: 50mm
        ThreadLength: 26mm
        ThreadDesignation: "M10 x 1.5"
    }

    Static NonstandardGeometry: HexBoltStandardRow = HexBoltStandardRow {
        Size: M8
        NominalDiameter: 8.25mm
        HeadAcrossFlats: 13.4mm
        HeadHeight: 5.5mm
        TopFlatDiameter: 12.7mm
        TopChamferAngle: 25deg
        UnderHeadRadius: 0.22mm
        TipChamferLength: 1mm
        TipDiameter: 6.3mm
    }

    Static Nonstandard825x375: HexBoltSpec = HexBoltSpec {
        StableId: "Nonstandard825x375"
        Standard: NonstandardGeometry
        Length: 37.5mm
        ThreadLength: 23mm
        ThreadDesignation: "M8.25 experimental"
        PropertyClass: "8.8"
    }

    Template < Spec: HexBoltSpec >
    Struct HexBolt: BoltConcept {
        Require PositiveNominal => Spec.Standard.NominalDiameter > 0mm
        Require HeadWiderThanShank => Spec.Standard.HeadAcrossFlats > Spec.Standard.NominalDiameter
        Require TopFlatInsideHex => Spec.Standard.TopFlatDiameter < Spec.Standard.HeadAcrossFlats
        Require PositiveHead => Spec.Standard.HeadHeight > 0mm
        Require ConeAngleValid => Spec.Standard.TopChamferAngle > 0deg && Spec.Standard.TopChamferAngle < 90deg
        Require BlendNonnegative => Spec.Standard.UnderHeadRadius >= 0mm
        Require TipReducesDiameter => Spec.Standard.TipDiameter < Spec.Standard.NominalDiameter
        Require TipFitsLength => Spec.Standard.TipChamferLength > 0mm && Spec.Standard.TipChamferLength < Spec.Length
        Require ThreadFits => Spec.ThreadLength >= 0mm && Spec.ThreadLength <= Spec.Length

        ExactCoaxialPart Body {
            Axis: +X
            RegularPolygonPrism Head {
                Sides: 6
                AcrossFlats: Spec.Standard.HeadAcrossFlats
                AxialHeight: Spec.Standard.HeadHeight
            }
            CoaxialConeTrim TopTreatment {
                FlatDiameter: Spec.Standard.TopFlatDiameter
                ConeAngle: Spec.Standard.TopChamferAngle
                IntersectionCurve: ExactConic
            }
            BoundedTorusBlend HeadToShaft {
                BlendRadius: Spec.Standard.UnderHeadRadius
                SplitPolicy: PeriodicHalfSupports
            }
            Cylinder Shaft {
                ShaftDiameter: Spec.Standard.NominalDiameter
                AxialLength: Spec.Length
            }
            CoaxialConeFrustum EndTreatment {
                EndChamferLength: Spec.Standard.TipChamferLength
                EndDiameter: Spec.Standard.TipDiameter
            }
            SemanticAxialRegion ThreadRegion {
                SemanticAxialRegionLength: Spec.ThreadLength
                Designation: Spec.ThreadDesignation
                MaterialGeometry: Cylinder
            }
            Metadata {
                StableId: Spec.StableId
                Grade: Spec.PropertyClass
            }
        }

        Expose {
            NominalDiameter: Spec.Standard.NominalDiameter
            Length: Spec.Length
            ThreadLength: Spec.ThreadLength
            ThreadDesignation: Spec.ThreadDesignation
            Axis: Body.Axis
        }
    }

    Struct ReferenceBolt = HexBolt <
        Spec: McMaster91180A151
    >
}

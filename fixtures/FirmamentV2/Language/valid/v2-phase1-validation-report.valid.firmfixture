// fixture-id: v2-phase1-validation-report
// case: firmament-v2-phase1-validation-report
// category: Language
// syntax-version: FirmamentV2
// validity: valid
// implementation: parser-backed
// expected: valid
// expected-stage: validation-report
// expected-parser: FirmamentV2Parser
// notes: R1 validation report fixture with lets, tolerances, Forge concepts, supported PMI, and export-deferred PMI.

model ValidationReportProbe {
    units mm

    let Process {
        minimumToolRadius: length = 1.5mm
        materialName: string = "Aluminum6061"
    }

    let MountingPattern {
        holeDiameter: length = 6.0mm tol 0.05mm
        countersinkDiameter: length = 10.0mm tol 0.10mm
        countersinkAngle: angle = 90deg tol 0.5deg
        spacing: length = 12.0mm tol +0.10mm -0.05mm
    }

    let nominalRadius: length = MountingPattern.holeDiameter / 2

    solid part: Box {
        size: [30, 20, 8]
        expose {
            face(+Z) => top
        }
    }

    manufacturing process<CNC> {
        material: Process.materialName
        minimumToolRadius: Process.minimumToolRadius
    }

    feature mountHole: hole<Countersink> {
        target: part.region("mountHoleA")
        diameter: MountingPattern.holeDiameter
        countersinkDiameter: MountingPattern.countersinkDiameter
        angle: MountingPattern.countersinkAngle
    }

    pmi {
        datum A { target: top }
        diameter mountHoleDiameter { target: part.region("mountHoleA") dimension: MountingPattern.holeDiameter }
        distance holeSpacing { targetA: part.region("mountHoleA") targetB: part.region("mountHoleB") dimension: MountingPattern.spacing }
        flatness baseFlatness { target: top tolerance: 0.03mm }
        parallel topParallel { target: top datum: A tolerance: 0.05mm }
    }
}

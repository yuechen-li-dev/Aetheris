// Side openings are wall features: cut them with Modify.
Model RoundedTray {
  units: mm
  Profile outline = RoundedRect2 { center: [0mm, 0mm]; size: [120mm, 80mm]; radius: 12mm }
  Compose<Hollow> body {
    wallThickness: 2mm
    openings: [Side]
    Base stock { profile: outline; from: 0mm; to: 24mm; role: Stock }
  }
}

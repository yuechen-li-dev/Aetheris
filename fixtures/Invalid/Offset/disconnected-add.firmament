Model DisconnectedOffsetAdd {
    Units: mm
    Rect2 Stock { Center: [0mm,0mm]; Size: [40mm,30mm] }
    Rect2 Tool { Center: [80mm,0mm]; Size: [4mm,4mm] }
    Profile StockProfile { Loop Outer { Stock.Bottom |> Stock.Right |> Stock.Top |> Stock.Left |> Close } }
    Profile ToolProfile { Loop Outer { Tool.Bottom |> Tool.Right |> Tool.Top |> Tool.Left |> Close } }
    Compose Plate {
        Base StockBody { Profile: StockProfile; From: 0mm; To: 10mm }
        AddOffset<Prism> Invalid { Target: Plate; On: Top; Profile: ToolProfile; Height: 3mm }
    }
}

Template < R: Length > Model AnalyticCylinder {
    units: mm; Cylinder Body { Radius: R; Height: 30mm; }
}
Template < W: Length > Struct MeshPlate {
    Circle2 Outer { center: [0mm,0mm]; radius: W; }
    Circle2 Inner { center: [0mm,0mm]; radius: 4mm; }
    Profile Ring { Loop Outer { Outer |> TraceLoop } Loop Bore { Inner as InnerBoundary |> TraceLoop } }
    Extrude Body { profile: Ring; from: 0mm; to: 5mm; }
}
Appearance CopperLook { color: [.55,.18,.06]; roughness: .3; metallic: .7; }
Material Copper { identity: "copper"; appearance: CopperLook; }
Appearance BlueSteelLook { color: [.02,.15,.5]; roughness: .5; metallic: .6; }
Material BlueSteel { identity: "steel"; appearance: BlueSteelLook; }
Assembly MixedDisplay {
    <Assembly MixedDisplay>
        <Part CylinderA = AnalyticCylinder<R:12mm>> material: Copper;
            Placement { from: Origin; to: Parent; }
        </Part>
        <Part CylinderB = AnalyticCylinder<R:12mm>>
            Placement { from: Origin; to: Parent; translateLocal: [50mm, 0mm, 0mm]; }
        </Part>
        <Part Mesh = MeshPlate<W:20mm>> material: BlueSteel;
            Placement { from: Origin; to: Parent; translateLocal: [0mm, -60mm, 10mm]; }
        </Part>
    </Assembly>
    anchor: MixedDisplay;
}

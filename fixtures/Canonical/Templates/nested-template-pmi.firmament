Model NestedTemplatePmi {
    units: mm

    Concept MountingPlateContract {
        Bounds: Box3
        TopPlane: Plane
        MountPoints: Point3[]
    }

    Template<> Struct PmiPlate {
        Concept Struct Design: MountingPlateContract {
            Bounds: Box3 { size: [40mm, 30mm, 8mm] }
            TopPlane: Bounds.Face(+Z)
            MountPoints: Grid {
                within: Bounds.Face(+Z).Inset(10mm)
                columns: 1
                rows: 1
            }
        }
        Box Base { bounds: Design.Bounds }
        Modify Base {
            Hole<Shaft> Mount {
                on: Base.Top
                center: Design.MountPoints[0]
                diameter: 6mm
                end: ThroughAll
            }
        }
        expose {
            Bounds: Design.Bounds
            TopPlane: Base.Top
            MountPoints: Design.MountPoints
        }
        Pmi {
            Datum A { Target: face(+Z) }
            HoleDiameter MountDiameter {
                Target: Mount
                Value: 6mm
                Tolerance: PlusMinus(0.05mm, 0.02mm)
            }
        }
    }

    Template<> Struct ProductFamily { Struct Generated = PmiPlate<> }
    Struct Product = ProductFamily<>
}

Model ComposePlate {
    Units: mm

    Concept Struct Layout On XY {
        Rect2 Stock { Center: [0mm, 0mm]; Size: [20mm, 10mm] }
    }

    Profile Plate Using Layout { Loop Outer {
     Stock.Bottom As South
     |> Stock.Right As East
     |> Stock.Top As North
     |> Stock.Left As West
     |> Close
 } }

    Struct PlateBody {
        Compose Body {
            Base Stock { Profile: Plate; From: -2mm; To: 2mm; Role: Stock }
        }
    }
}

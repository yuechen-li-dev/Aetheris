// Minimal source-independent single-bend bracket.
SheetMetal LBracket {
    Thickness: 1.5mm;
    Material: "5052-H32 Aluminum";
    KFactor: 0.42;
    Base Main { Profile: Rectangle { Width: 80mm; Height: 40mm; }; }
    Flange Wall {
        From: Main.Left;
        Length: 25mm;
        Angle: 90deg;
        InsideRadius: 2mm;
        Direction: Up;
    }
}

Model CircularBossThroughHole {
    units: mm

    Concept Struct Layout on XY {
        Rect2 Stock { center: [0mm, 0mm]; size: [50mm, 32mm] }
        Point2 Center { position: [0mm, 0mm] }
        Point2 East { position: [8mm, 0mm] }
        Point2 North { position: [0mm, 8mm] }
        Point2 West { position: [-8mm, 0mm] }
        Point2 South { position: [0mm, -8mm] }
        Circle2 Pad { center: Center; radius: 8mm }
    }
    Profile BaseProfile using Layout { Loop Outer {
     Stock.Bottom
     |> Stock.Right
     |> Stock.Top
     |> Stock.Left
     |> Close
 } }
    Profile BossProfile using Layout { Loop Outer {
        Pad |> TraceLoop
    } }

    Struct BearingMount {
        Compose Body {
            Base Stock { profile: BaseProfile; from: 0mm; to: 8mm; role: Stock }
            Boss BearingBoss { on: Top; profile: BossProfile; height: 6mm }
            Hole<Shaft> BearingBore { on: +Z; center: [0mm, 0mm]; diameter: 8mm; end: ThroughAll }
        }
    }
}

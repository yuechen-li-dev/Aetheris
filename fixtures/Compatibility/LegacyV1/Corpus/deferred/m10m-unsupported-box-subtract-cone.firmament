firmament:
  version: 1

model:
  name: m10m_unsupported_box_subtract_cone
  units: mm

ops[2]:
  -
    op: box
    id: base
    size[3]:
      20
      20
      10

  -
    op: subtract
    id: tapered_cut
    from: base
    with:
      op: cone
      bottom_radius: 4
      top_radius: 2
      height: 6

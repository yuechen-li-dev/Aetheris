Units: mm
SpurGear G { Module: 2mm Teeth: 20 PressureAngle: 20deg FaceWidth: 6mm BoreDiameter: 5mm }
Subassembly Cell { <Assembly Cell><Part Hidden = G></Part></Assembly> Anchor: Cell.Hidden; }
Assembly PrivateAccess {
  <Assembly PrivateAccess><Assembly A = Cell></Assembly><Assembly B = Cell></Assembly></Assembly>
  Anchor: PrivateAccess.A;
  Interface<Gear> Illegal { A: PrivateAccess.A.Hidden; B: PrivateAccess.B.Hidden; }

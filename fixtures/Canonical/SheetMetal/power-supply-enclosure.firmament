Profile acInletProfile = Rect2 { center: [0mm, 0mm]; size: [20mm, 28mm] }
Profile dcOutletProfile = Rect2 { center: [0mm, 0mm]; size: [14mm, 24mm] }

Use SheetMetal.ProductFamilies;

Static PsuSpec: EnclosureSpec = EnclosureSpec {
    Width: 150mm
    Depth: 100mm
    Height: 42mm
    LidLipHeight: 7mm
    Thickness: 1.2mm
    InsideRadius: 1.5mm
    KFactor: 0.42
    ReliefPolicy: Rectangular
}

SheetMetal PsuEnclosure = ElectronicsEnclosure < Spec: PsuSpec >

Extend SheetMetal PsuEnclosure {
    Cut AcInlet { on: Rear; at: Point2(32mm, 21mm); profile: acInletProfile; }
    Cut DcOutlet { on: Front; at: Point2(115mm, 21mm); profile: dcOutletProfile; }
    Hole Mount1 { on: Body; center: Point2(20mm, 20mm); diameter: 4mm; }
    Hole Mount2 { on: Body; center: Point2(130mm, 20mm); diameter: 4mm; }
    Hole Mount3 { on: Body; center: Point2(20mm, 80mm); diameter: 4mm; }
    Hole Mount4 { on: Body; center: Point2(130mm, 80mm); diameter: 4mm; }
}

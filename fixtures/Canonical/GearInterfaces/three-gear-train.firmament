Model ThreeGearTrain {
    units: mm
    SpurGear A { Module: 1mm Teeth: 20 PressureAngle: 20deg FaceWidth: 6mm BoreDiameter: 5mm }
    SpurGear Idler { Module: 1mm Teeth: 30 PressureAngle: 20deg FaceWidth: 6mm BoreDiameter: 5mm Phase: 6deg }
    SpurGear C { Module: 1mm Teeth: 40 PressureAngle: 20deg FaceWidth: 6mm BoreDiameter: 5mm }
    Interface<Gear> AToIdler { a: A b: Idler }
    Interface<Gear> IdlerToC { a: Idler b: C }
}

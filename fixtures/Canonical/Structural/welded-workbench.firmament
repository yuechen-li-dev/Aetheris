Model WeldedWorkbench {
    Units: mm

    Structure WorkbenchFrame {
        Node FLL = [0mm, 0mm, 0mm];
        Node FRL = [1000mm, 0mm, 0mm];
        Node BRL = [1000mm, 600mm, 0mm];
        Node BLL = [0mm, 600mm, 0mm];
        Node FLT = [0mm, 0mm, 800mm];
        Node FRT = [1000mm, 0mm, 800mm];
        Node BRT = [1000mm, 600mm, 800mm];
        Node BLT = [0mm, 600mm, 800mm];
        Node CrossAFront = [333.333333mm, 0mm, 800mm];
        Node CrossABack = [333.333333mm, 600mm, 800mm];
        Node CrossBFront = [666.666667mm, 0mm, 800mm];
        Node CrossBBack = [666.666667mm, 600mm, 800mm];

        Path FrontRail: FLT -> FRT;
        Path RightRail: FRT -> BRT;
        Path BackRail: BRT -> BLT;
        Path LeftRail: BLT -> FLT;
        Path FrontLeftLeg: FLL -> FLT;
        Path FrontRightLeg: FRL -> FRT;
        Path BackRightLeg: BRL -> BRT;
        Path BackLeftLeg: BLL -> BLT;
        Path CrossmemberA: CrossAFront -> CrossABack;
        Path CrossmemberB: CrossBFront -> CrossBBack;
    }

    Section Tube40x40x3 {
        Kind: Standard.Structural.SquareTube;
        Width: 40mm;
        Thickness: 3mm;
    }

    Record StructuralMemberRow { Name: String Path: String Section: String Material: String Orientation: String }
    Static Table Members: StructuralMemberRow Key: Name {
        Name: ["FrontRail", "RightRail", "BackRail", "LeftRail", "FrontLeftLeg", "FrontRightLeg", "BackRightLeg", "BackLeftLeg", "CrossmemberA", "CrossmemberB"]
        Path: ["FrontRail", "RightRail", "BackRail", "LeftRail", "FrontLeftLeg", "FrontRightLeg", "BackRightLeg", "BackLeftLeg", "CrossmemberA", "CrossmemberB"]
        Section: ["Tube40x40x3", "Tube40x40x3", "Tube40x40x3", "Tube40x40x3", "Tube40x40x3", "Tube40x40x3", "Tube40x40x3", "Tube40x40x3", "Tube40x40x3", "Tube40x40x3"]
        Material: ["Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36", "Standard.Materials.Steel.ASTM_A36"]
        Orientation: ["UpZ", "UpZ", "UpZ", "UpZ", "UpX", "UpX", "UpX", "UpX", "UpZ", "UpZ"]
    }

    Record StructuralJointRow { Name: String Type: String FirstMember: String FirstEnd: String SecondMember: String SecondEnd: String Primary: String }
    Static Table Joints: StructuralJointRow Key: Name {
        Name: ["FrontRightMiter", "BackRightMiter", "BackLeftMiter", "FrontLeftMiter", "FrontLeftButt", "FrontRightButt", "BackRightButt", "BackLeftButt", "CrossAFrontButt", "CrossABackButt", "CrossBFrontButt", "CrossBBackButt"]
        Type: ["Miter", "Miter", "Miter", "Miter", "Butt", "Butt", "Butt", "Butt", "Butt", "Butt", "Butt", "Butt"]
        FirstMember: ["FrontRail", "RightRail", "BackRail", "LeftRail", "FrontRail", "FrontRail", "BackRail", "BackRail", "FrontRail", "BackRail", "FrontRail", "BackRail"]
        FirstEnd: ["End", "End", "End", "End", "Start", "End", "Start", "End", "Start", "Start", "Start", "Start"]
        SecondMember: ["RightRail", "BackRail", "LeftRail", "FrontRail", "FrontLeftLeg", "FrontRightLeg", "BackRightLeg", "BackLeftLeg", "CrossmemberA", "CrossmemberA", "CrossmemberB", "CrossmemberB"]
        SecondEnd: ["Start", "Start", "Start", "Start", "End", "End", "End", "End", "Start", "End", "Start", "End"]
        Primary: ["FrontRail", "RightRail", "BackRail", "LeftRail", "FrontRail", "FrontRail", "BackRail", "BackRail", "FrontRail", "BackRail", "FrontRail", "BackRail"]
    }

    Record StructuralWeldRow { Name: String Joint: String Type: String Size: Length }
    Static Table Welds: StructuralWeldRow Key: Name {
        Name: ["W01", "W02", "W03", "W04", "W05", "W06", "W07", "W08", "W09", "W10", "W11", "W12"]
        Joint: ["FrontRightMiter", "BackRightMiter", "BackLeftMiter", "FrontLeftMiter", "FrontLeftButt", "FrontRightButt", "BackRightButt", "BackLeftButt", "CrossAFrontButt", "CrossABackButt", "CrossBFrontButt", "CrossBBackButt"]
        Type: ["Fillet", "Fillet", "Fillet", "Fillet", "Fillet", "Fillet", "Fillet", "Fillet", "Fillet", "Fillet", "Fillet", "Fillet"]
        Size: [4mm, 4mm, 4mm, 4mm, 4mm, 4mm, 4mm, 4mm, 4mm, 4mm, 4mm, 4mm]
    }
}

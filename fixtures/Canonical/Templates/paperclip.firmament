Model StandardProductsOfficePaperclip {
    Units: mm
    Record PaperclipPolicy {
        WireDiameter: Length
        OuterLegLength: Length
        InnerLegLength: Length
        OuterBendRadius: Length
        InnerBendRadius: Length
        Material: String
    }
    Static StandardPaperclip: PaperclipPolicy = PaperclipPolicy {
        WireDiameter: 1mm
        OuterLegLength: 15mm
        InnerLegLength: 14mm
        OuterBendRadius: 5mm
        InnerBendRadius: 3mm
        Material: "Standard.Materials.StainlessSteel.304_Annealed"
    }
    Template < P: PaperclipPolicy >
    Struct PaperclipTemplate {
        Require PositiveWireDiameter => P.WireDiameter > 0mm
        Require PositiveLegLengths => P.OuterLegLength > 0mm && P.InnerLegLength > 0mm
        Require OuterLegExceedsInnerLeg => P.OuterLegLength > P.InnerLegLength
        Require PositiveBendRadii => P.OuterBendRadius > 0mm && P.InnerBendRadius > 0mm
        Require OuterBendExceedsInnerBend => P.OuterBendRadius > P.InnerBendRadius
        Require InnerBendClearsWire => P.InnerBendRadius > P.WireDiameter
        Concept Path PaperclipPath {
            // The reference frame places the inner-right terminal at X=8 mm.
            Start: Point2(8mm, 0mm)
            Heading: 90deg
            Line InnerRightUp { Length: P.InnerLegLength }
            Arc InnerTop { Radius: P.InnerBendRadius; Turn: 180deg }
            Line InnerLeftDown { Length: P.InnerLegLength }
            Arc LowerReturn { Radius: (P.OuterBendRadius + P.InnerBendRadius) / 2; Turn: 180deg }
            Line OuterRightUp { Length: P.OuterLegLength }
            Arc OuterTop { Radius: P.OuterBendRadius; Turn: 180deg }
            Line OuterLeftDown { Length: P.OuterLegLength }
        }
        Sweep Paperclip {
            Path: PaperclipPath
            Diameter: P.WireDiameter
            Material: P.Material
        }
    }
    Struct Paperclip = PaperclipTemplate < P: StandardPaperclip >
}

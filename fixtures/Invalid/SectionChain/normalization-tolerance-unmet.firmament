Model NormalizedRoundedSections {
 Units: mm
 Concept Struct Frames {
  A: Plane { Origin: [0mm,0mm,0mm] Normal: [0,0,1] Up: [0,1,0] }
  B: Plane { Origin: [0mm,0mm,8mm] Normal: [0,0,1] Up: [0,1,0] }
  C: Plane { Origin: [0mm,0mm,16mm] Normal: [0,0,1] Up: [0,1,0] }
 }
 Construction Plane FA { Trace: Frames.A }
 Construction Plane FB { Trace: Frames.B }
 Construction Plane FC { Trace: Frames.C }
 RoundedRect2 Outline { Center: [0mm,0mm] Size: [60mm,40mm] Radius: 8mm }
 Profile P { Loop Outer { Outline |> TraceLoop } }
 SectionChain RoundedSections {
  Continuity: G1
  ApproximationTolerance: 0.00000000000000000001mm
  Section A {
   Frame: FA
   Profile: P
   Seam: Bottom
  }
  Section B {
   Frame: FB
   Profile: P
   Seam: Bottom
  }
  Section C {
   Frame: FC
   Profile: P
   Seam: Bottom
  }
  Start: Cap
  End: Cap
 }
}

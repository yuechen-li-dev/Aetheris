Include "pickups-assembly.firmament";
Include "knob.firmament";
Include "selector.firmament";

// Named controls retain explicit seat heights on the carved body.
Static KnobSeats: Set<HardwareSite> {
 NeckVolume => HardwareSite { X: 79mm; Y: -95mm; Z: 50mm }
 BridgeVolume => HardwareSite { X: 123mm; Y: -70mm; Z: 45mm }
 NeckTone => HardwareSite { X: 75mm; Y: -156mm; Z: 47mm }
 BridgeTone => HardwareSite { X: 121mm; Y: -131mm; Z: 43mm }
}
Subassembly GuitarElectronics {
 <Assembly GuitarElectronics>
  Pattern Controls Over KnobSeats {
   seat => <Assembly Knob = ControlKnob>
    Placement { From: Mount; To: World; TranslateLocal: [seat.X,seat.Y,seat.Z]; }
   </Assembly>
  }
  <Assembly Selector = PickupSelector>
   Placement { From: Mount; To: World; TranslateLocal: [-73mm,137mm,43mm]; }
  </Assembly>
  <Part ControlCover = Panel<L:63mm,W:93mm,H:1mm,R:15mm>>
   Placement { From: Origin; To: World; TranslateLocal: [85mm,-115mm,-1mm]; }
  </Part>
  <Part SelectorCover = Drum<R:24mm,H:1mm>>
   Placement { From: Origin; To: World; TranslateLocal: [-73mm,137mm,-1mm]; }
  </Part>
  <Assembly Pickups = GuitarPickups>
   Placement { From: Origin; To: World; }
  </Assembly>
 </Assembly>
 Anchor: GuitarElectronics;
}

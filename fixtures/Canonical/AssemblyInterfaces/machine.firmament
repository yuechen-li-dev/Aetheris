include "register.firmament";

Assembly DifferenceEngineReadiness {
    <Assembly DifferenceEngineReadiness>
        <Assembly RegisterA = Register></Assembly>
        <Assembly RegisterB = Register></Assembly>
    </Assembly>

    anchor: DifferenceEngineReadiness.RegisterA.Output;

    // The parent sees only public ports; no Digit or Shaft path crosses the boundary.
    Interface<Axial> RegisterCarry {
        a: DifferenceEngineReadiness.RegisterB.Input;
        b: DifferenceEngineReadiness.RegisterA.Output;
    }
}

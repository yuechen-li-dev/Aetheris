Model PlaneDrillFlat {
    units: mm
    Profile Plate = Rect2 { center: [0mm, 0mm]; size: [60mm, 30mm] }
    Compose Body { Base Stock { profile: Plate; from: -10mm; to: 0mm; role: Stock } }
    Concept Struct Datums { Front: Plane { origin: [0mm, -15mm, 0mm]; normal: [0, 1, 0]; up: [0, 0, 1] } }
    Construction Plane FrontFace { trace: Datums.Front }
    Modify Body {
        Hole<Shaft> A { from: FrontFace; center: Point2(0mm, -5mm); diameter: 4mm; end: Blind 8mm; termination: Flat }
    }
}

model SideHoleAliasReverseXV2 {
    units mm

    solid base: Box {
        size: [10, 8, 6]

        expose {
            face(-X) => left
            face(+X) => right
        }
    }

    modify base {
        region sideHole on left {
            cut Cylinder {
                radius: 1
                center: [1, 0]
                through: right
            }
        }
    }
}

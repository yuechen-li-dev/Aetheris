Profile deckProfile = Rect2 { center: [(100mm) / 2, (50mm) / 2]; size: [100mm, 50mm] }

Use Profile.Modifications;

Static AddedTab: ProfileTabSpec = ProfileTabSpec {
  Center: 50mm
  Width: 15mm
  Extension: 6mm
}
ProfileDelta ServiceTab = Tab < P: AddedTab, Owner: Wall.Outer >

SheetMetal TabAreaWitness {
  thickness: 1mm;
  Base Deck { profile: deckProfile; }
  Flange Wall { from: Deck.Front; height: 35mm; angle: 90deg; radius: 2mm; }
}

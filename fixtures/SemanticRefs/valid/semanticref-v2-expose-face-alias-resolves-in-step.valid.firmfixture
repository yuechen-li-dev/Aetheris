// notes: STEP-V2-X3 face alias fixture proves expose face(+Z) => top is consumed by a later semantic shaft hole before real Step242Exporter output.
model SemanticRefV2ExposeFaceAliasResolvesInStep {
    units mm

    solid base: Box {
        size: [10, 8, 6]

        expose {
            face(+Z) => top
        }
    }

    modify base {
        hole<shaft> mount {
            on: top
            center: [0, 0]
            diameter: 2
            end: throughAll
        }
    }
}

Model SetFeaturePattern {
    units: mm
    Feature Drill(Center: Point2) -> Hole<Shaft> {
        return Hole<Shaft> { on: +Z center: Center diameter: 6mm end: ThroughAll }
    }
    Static Points: Set<Point2> {
        First => Point2(-12mm, 0mm)
        Second => Point2(12mm, 0mm)
    }
    Box Base { size: [50mm, 30mm, 8mm] }
    Modify Base {
        Pattern Drills over Points { point => Drill(point) }
    }
}

schema Mechanical

Path Stadium {
    start: Point2(0mm, 0mm)
    heading: 0deg
    Line Bottom { length: 30mm }
    Arc Right { Radius: 8mm; Turn: 180deg }
    Line Top { length: 30mm }
    Arc Left { Radius: 8mm; Turn: 180deg }
}

Profile StadiumProfile {
    Loop Outer {
        Stadium.Bottom
        |> Stadium.Right
        |> Stadium.Top
        |> Stadium.Left
        |> Close
    }
}

Extrude Solid { profile: StadiumProfile; from: 0mm; to: 5mm }

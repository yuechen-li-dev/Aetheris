Model OpenSectionChain {
 units: mm
 Concept Struct Stations {
  A: Plane { Origin: [0mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  B: Plane { Origin: [20mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
 }
 Construction Plane FA { Trace: Stations.A }
 Construction Plane FB { Trace: Stations.B }
 Path Outline { start: Point2(-5mm,-4mm) heading: 0deg Line Bottom { length: 10mm } Line Right { Turn: 90deg; length: 8mm } Line Top { Turn: 90deg; length: 10mm } Close Left }
 Profile P from Outline
 SectionChain OpenSectionChain {
  Transition: Ruled
  Section A { frame: FA
   profile: P
   seam: Bottom }
  Section B { frame: FB
   profile: P
   seam: Bottom }
  start: Open
  end: Open
 }
}

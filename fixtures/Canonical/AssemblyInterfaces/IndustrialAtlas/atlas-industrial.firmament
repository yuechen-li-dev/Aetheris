// ATLAS: source-owned rigid components and four articulated interfaces.
// Exact presentation geometry; nominal dimensions, not a manufacturing release.
include "materials.firmament";
include "hardware.firmament";
include "base.firmament";
include "upper-arm.firmament";
include "fore-arm.firmament";
include "gripper.firmament";
Assembly AtlasIndustrial {
 <Assembly AtlasIndustrial>
  <Assembly Base = AtlasBase></Assembly>
  <Assembly UpperArm = AtlasUpperArm></Assembly>
  <Assembly ForeArm = AtlasForeArm></Assembly>
  <Part Gripper = GripperBody<H:28mm>> material: Steel with { appearance: BlackPaint; }; </Part>
  <Assembly LeftJaw = AtlasLeftJaw></Assembly>
  <Assembly RightJaw = AtlasRightJaw></Assembly>
 </Assembly>
 anchor: AtlasIndustrial.Base;
 Interface<Revolute> Shoulder { a: AtlasIndustrial.Base.Hinge; b: AtlasIndustrial.UpperArm.Input; }
 Interface<Revolute> Elbow { a: AtlasIndustrial.UpperArm.Output; b: AtlasIndustrial.ForeArm.Input; }
 Interface<Fixed> WristMount { a: AtlasIndustrial.ForeArm.Output; b: AtlasIndustrial.Gripper.Input.Frame; }
 Interface<Prismatic> GripLeft { a: AtlasIndustrial.Gripper.Left; b: AtlasIndustrial.LeftJaw.Slide; }
 Interface<Prismatic> GripRight { a: AtlasIndustrial.Gripper.Right; b: AtlasIndustrial.RightJaw.Slide; }
}

// ATLAS: exact Aetheris SCARA demonstrator. Appearance is a downstream USD override.
Template<R: Length, H: Length> Struct Pedestal {
 Circle2 Outside { center: [0mm,0mm] radius: R }
 Circle2 Inside { center: [0mm,0mm] radius: 36mm }
 Profile Section { Loop Outer { Outside |> TraceLoop } Loop Inner { Inside as InnerBoundary |> TraceLoop } }
 Extrude Body { profile: Section from: 0mm to: H }
}
Template<L: Length, W: Length, H: Length> Struct GuardLink {
 Rect2 Stock { center: [70mm,0mm] size: [L,W] }
 Circle2 Vent1 { center: [40mm,0mm] radius: 7mm }
 Circle2 Vent2 { center: [60mm,0mm] radius: 7mm }
 Circle2 Vent3 { center: [80mm,0mm] radius: 7mm }
 Profile Section {
  Loop Outer { Stock.Bottom |> Stock.Right |> Stock.Top |> Stock.Left |> Close }
  Loop Vent1 { Vent1 as Vent1Boundary |> TraceLoop }
  Loop Vent2 { Vent2 as Vent2Boundary |> TraceLoop }
  Loop Vent3 { Vent3 as Vent3Boundary |> TraceLoop }
 }
 Extrude Body { profile: Section from: 0mm to: H }
}
Template<R: Length> Struct JointRing {
 Circle2 Outside { center: [0mm,0mm] radius: R }
 Circle2 Inside { center: [0mm,0mm] radius: 13mm }
 Profile Section { Loop Outer { Outside |> TraceLoop } Loop Inner { Inside as InnerBoundary |> TraceLoop } }
 Extrude Body { profile: Section from: -3mm to: 3mm }
}
Template<W: Length> Struct GripperHead {
 Rect2 Stock { center: [0mm,0mm] size: [28mm,W] }
 Profile Section { Loop Outer { Stock.Bottom |> Stock.Right |> Stock.Top |> Stock.Left |> Close } }
 Extrude Body { profile: Section from: 0mm to: 18mm }
}
Template<L: Length> Struct Finger {
 Rect2 Stock { center: [22.5mm,0mm] size: [L,8mm] }
 Profile Section { Loop Outer { Stock.Bottom |> Stock.Right |> Stock.Top |> Stock.Left |> Close } }
 Extrude Body { profile: Section from: -20mm to: 0mm }
}
Assembly Atlas {
 <Assembly Atlas>
  <Part Base = Pedestal<R: 50mm, H: 60mm>>
   Semantic Hinge { DatumFrame Frame = [0,0,60] x [1,0,0] y [0,1,0] z [0,0,1]; }
  </Part>
  <Assembly UpperArm>
   Placement { from: Origin; to: Parent; }
   <Part Housing = GuardLink<L: 160mm, W: 44mm, H: 22mm>>
    Semantic Input { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,1,0] z [0,0,1]; }
    Semantic Output { DatumFrame Frame = [150,0,24] x [1,0,0] y [0,1,0] z [0,0,1]; }
    Semantic Collar { DatumFrame Frame = [0,0,24] x [1,0,0] y [0,1,0] z [0,0,1]; }
   </Part>
   <Part ShoulderCollar = JointRing<R: 26mm>>
    Semantic Mount { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,1,0] z [0,0,1]; }
   </Part>
   <Part ElbowCollar = JointRing<R: 26mm>>
    Semantic Mount { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,1,0] z [0,0,1]; }
   </Part>
  </Assembly>
  <Assembly ForeArm>
   Placement { from: Origin; to: Parent; }
   <Part Housing = GuardLink<L: 130mm, W: 34mm, H: 16mm>>
    Semantic Input { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,1,0] z [0,0,1]; }
    Semantic Output { DatumFrame Frame = [130,0,20] x [1,0,0] y [0,1,0] z [0,0,1]; }
    Semantic Collar { DatumFrame Frame = [0,0,20] x [1,0,0] y [0,1,0] z [0,0,1]; }
   </Part>
   <Part WristCollar = JointRing<R: 26mm>>
    Semantic Mount { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,1,0] z [0,0,1]; }
   </Part>
  </Assembly>
  <Part Wrist = GripperHead<W: 54mm>>
   Semantic Mount { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,1,0] z [0,0,1]; }
   Semantic Left { DatumFrame Frame = [0,12,0] x [1,0,0] y [0,0,-1] z [0,1,0]; }
   Semantic Right { DatumFrame Frame = [0,-12,0] x [1,0,0] y [0,0,1] z [0,-1,0]; }
  </Part>
  <Part LeftFinger = Finger<L: 45mm>>
   Semantic Slide { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,0,-1] z [0,1,0]; }
  </Part>
  <Part RightFinger = Finger<L: 45mm>>
   Semantic Slide { DatumFrame Frame = [0,0,0] x [1,0,0] y [0,0,1] z [0,-1,0]; }
  </Part>
 </Assembly>
 anchor: Atlas.Base.Hinge;
 Interface<Revolute> Shoulder { a: Atlas.Base.Hinge; b: Atlas.UpperArm.Housing.Input; }
 Interface<Revolute> Elbow { a: Atlas.UpperArm.Housing.Output; b: Atlas.ForeArm.Housing.Input; }
 Interface<Fixed> WristMount { a: Atlas.ForeArm.Housing.Output; b: Atlas.Wrist.Mount; }
 Interface<Prismatic> GripLeft { a: Atlas.Wrist.Left; b: Atlas.LeftFinger.Slide; }
 Interface<Prismatic> GripRight { a: Atlas.Wrist.Right; b: Atlas.RightFinger.Slide; }
 Interface<Fixed> ShoulderTrim { a: Atlas.UpperArm.Housing.Collar; b: Atlas.UpperArm.ShoulderCollar.Mount; }
 Interface<Fixed> ElbowTrim { a: Atlas.UpperArm.Housing.Output; b: Atlas.UpperArm.ElbowCollar.Mount; }
 Interface<Fixed> WristTrim { a: Atlas.ForeArm.Housing.Output; b: Atlas.ForeArm.WristCollar.Mount; }
}

// expected-feature-air: CreateBox
// expected-exposure-count: 4
// expected-exposure: top = FaceRef face(+Z)
// expected-exposure: bottom = FaceRef face(-Z)
// expected-exposure: right = FaceRef face(+X)
// expected-exposure: topRim = LoopRef face(+Z).outerLoop
// parser-backed: true
// notes: AIR-FIRMAMENT-X3 parser-backed Box semantic exposure fixture advanced from A2.1 metadata-only design coverage.

model NamedBoxFaces {
    units mm

    solid base: Box {
        size: [10, 8, 6]

        expose {
            face(+Z) => top
            face(-Z) => bottom
            face(+X) => right
            face(+Z).outerLoop => topRim
        }
    }
}

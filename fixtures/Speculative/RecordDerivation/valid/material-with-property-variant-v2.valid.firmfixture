model MaterialWithPropertyVariant {
    units mm

    material steel = Isotropic {
        youngs: 200 GPa
        poisson: 0.30
        density: 7850 kg/m^3
    }

    material softSteel = steel with {
        youngs: 180 GPa
    }
}

// notes: INLINE-STEP-X2 attaches semantic diameter PMI to canonical imported cylindrical face #191; cylindrical face type checking is deferred to stronger topology typing.
model InlineStepHoleDiameterPmiOnCanonicalFace {
    units mm

    solid importedPart: InlineStep {
        path: "../testdata/canonical-through-hole.step"
    }

    pmi {
        diameter holeDiameter {
            target: importedPart.face("#191")
            value: 2mm
        }
    }
}

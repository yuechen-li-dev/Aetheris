Template < R: Length > Struct Sleeve {
    Circle2 Outside { center: [0mm,0mm] radius: R }
    Circle2 Inside { center: [0mm,0mm] radius: 15mm }
    Profile Section { Loop Outer { Outside |> TraceLoop } Loop Inner { Inside as InnerBoundary |> TraceLoop } }
    Extrude Body { profile: Section from: -10mm to: 10mm }
}
Assembly AnnularPair {
    <Assembly AnnularPair>
        <Part First = Sleeve<R: 20mm>>
            Placement { from: Origin; to: Parent; }
        </Part>
        <Part Second = Sleeve<R: 20mm>>
            Placement { from: Origin; to: Parent; translateLocal: [60mm, 0mm, 0mm]; }
        </Part>
    </Assembly>
    anchor: AnnularPair;
}

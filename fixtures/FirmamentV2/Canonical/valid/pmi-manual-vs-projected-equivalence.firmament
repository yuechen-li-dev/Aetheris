Model ManualProjectedEquivalence {
    Units: mm
    Box Base { Size: [80mm, 50mm, 12mm] }
    Modify Base {
        Hole<Shaft> ManualMount { On: +Z Center: Point2(15mm, 20mm) Diameter: 8mm End: ThroughAll }
        Hole<Shaft> ProjectedMount { On: +Z Center: Point2(35mm, 20mm) Diameter: 8mm End: ThroughAll }
    }
    Require ProjectedDiameter { Actual: ProjectedMount.Diameter Expected: 8mm Tolerance: PlusMinus(0.05mm, 0.02mm) }
    Pmi {
        Datum A { Target: face(+Z) }
        HoleDiameter ManualCallout { Target: ManualMount Value: 8mm Tolerance: PlusMinus(0.05mm, 0.02mm) DatumRefs: [A] }
        HoleDiameter ProjectedCallout { From: ProjectedDiameter As: HoleDiameter DatumRefs: [A] }
    }
}

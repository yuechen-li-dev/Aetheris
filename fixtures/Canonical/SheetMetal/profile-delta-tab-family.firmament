Profile deckProfile = Rect2 { center: [(100mm) / 2, (60mm) / 2]; size: [100mm, 60mm] }

Use Profile.Modifications;

Static Table TabStandards: ProfileTabSpec {
    Center: [40mm, 60mm]
    Width: [20mm, 28mm]
    Extension: [6mm, 8mm]
}
Static StandardServiceTab = TabStandards[1]
Static WideServiceTab: ProfileTabSpec = StandardServiceTab with {
    Width: 32mm
}

ProfileDelta ServiceTab = Tab < P: WideServiceTab, Owner: Wall.Outer >

SheetMetal TabbedBracket {
    thickness: 1.5mm;
    material: "5052-H32 Aluminum";
    kFactor: 0.42;
    Base Deck { profile: deckProfile; }
    Flange Wall { from: Deck.Rear; height: 24mm; angle: 90deg; radius: 2mm; }
}

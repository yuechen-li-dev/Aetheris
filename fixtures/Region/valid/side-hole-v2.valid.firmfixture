// notes: AIR-FIRMAMENT-X4 parser-backed controlled V2 side-hole region fixture. SIDEHOLE-REAL-X1 real AP242 proof lives in feature-v2-side-hole-step-verified.valid.firmfixture.

model SideHoleV2 {
    units mm

    solid base: Box {
        size: [10, 8, 6]
    }

    modify base {
        region sideHole on face(+X) {
            cut Cylinder {
                radius: 1
                through: face(-X)
            }
        }
    }
}

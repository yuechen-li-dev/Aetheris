Concept Struct SlotLayout On XY {
  Rect2 Stock { Center: [0mm,0mm]; Size: [200mm,100mm] }
}
Profile Plate Using SlotLayout { Loop Outer {
     Stock.Bottom As South
     |> Stock.Right As East
     |> Stock.Top As North
     |> Stock.Left As West
     |> Close
 } }
Struct SlotFixture { Compose SlotBody {
  Base Stock { Profile: Plate; From: -10mm; To: 10mm; Role: Stock }
  Slot<Capsule> Relief { Center: Point2(0mm,0mm); Direction: Vector2(1,0); Length: 80mm; Width: 40mm; Extent: ThroughAll; Role: ThroughSlot }
} }
Selection ReliefEntry { Target: SlotEntry Source: Slot(Relief) Require: ClosedLoop }
Selection ReliefStraightWalls { Target: SlotStraightWall Source: Slot(Relief) Require: NonEmptyFaceSet }
Selection ReliefEndWalls { Target: SlotEndWall Source: Slot(Relief) Require: NonEmptyFaceSet }

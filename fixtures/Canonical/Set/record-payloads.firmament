Model NamedRecordPayloads {
    units: mm
    Record MountSpec { Center: Point2 Diameter: Length }
    Static Mounts: Set<MountSpec> {
        Left => MountSpec { Center: Point2(-20mm, 0mm) Diameter: 8mm }
        Right => MountSpec { Center: Point2(20mm, 0mm) Diameter: 8mm }
    }
    Template<spec: MountSpec> MountHole {
        Hole<Shaft> Mount { on: +Z center: spec.Center diameter: spec.Diameter end: ThroughAll }
    }
    Box Base { size: [80mm, 40mm, 10mm] }
    Modify Base {
        Pattern MountPattern over Mounts { spec => MountHole<Current> }
    }
}

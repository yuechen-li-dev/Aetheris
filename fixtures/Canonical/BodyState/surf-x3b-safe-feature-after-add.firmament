Model SurfX3bSafeFeatureAfterAdd {
  Units: mm
  SectionChain GripChain {
    StartTermination: Open
    EndTermination: Cap
    Station Attach { Origin: [0mm, 0mm, 10mm]
      Size: [40mm, 20mm] }
    Station Neck { Origin: [15mm, 0mm, 10mm]
      Size: [30mm, 17mm] }
    Station Tail { Origin: [40mm, 0mm, 10mm]
      Size: [12mm, 8mm] }
  }
  BodyState Base {
    Size: [80mm, 40mm, 20mm]
    Hole MountA { Center: [-25mm, -12mm]
      Diameter: 4mm }
    Hole MountB { Center: [25mm, 12mm]
      Diameter: 4mm }
  }
  SculptState GripAdded {
    Input: Base
    AddSectionChain Grip { Chain: GripChain
      Support: HousingSideEast
      Terminal: Attach
      InfluenceEnvelope: [40mm, -20mm, 0mm, 80mm, 20mm, 20mm] }
    MayModify: [HousingSideEast]
    Preserve: [BottomMountingInterface, MountingHolePattern]
    Require: [ClosedManifold, OrientationConsistency, NoSelfIntersection]
  }
  SculptState PortAdded {
    Input: GripAdded
    HoleFeature Port { Target: HousingCrown
      Id: ServicePort
      Center: [0mm, 10mm]
      Diameter: 3mm
      InfluenceEnvelope: [-1.5mm, 8.5mm, 0mm, 1.5mm, 11.5mm, 20mm] }
    Preserve: [OuterFootprintBoundary, GripChain.AttachedSurface]
    Require: [ClosedManifold, OrientationConsistency, NoSelfIntersection]
  }
  Output: PortAdded
}

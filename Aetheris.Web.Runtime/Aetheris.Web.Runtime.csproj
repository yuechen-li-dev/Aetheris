<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>bootstrap.js</WasmMainJSPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Browser WebAssembly host for the public Aetheris CAD TypeScript SDK.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aetheris.Kernel.Firmament\Aetheris.Kernel.Firmament.csproj" />
    <!-- The JSON bridge serializes anonymous response shapes through reflection. -->
    <TrimmerRootAssembly Include="Aetheris.Web.Runtime" />
    <TrimmerRootAssembly Include="Aetheris.Kernel.Firmament" />
  </ItemGroup>
</Project>

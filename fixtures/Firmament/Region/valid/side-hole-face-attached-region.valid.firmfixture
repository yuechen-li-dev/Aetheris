// description: Face-attached side-hole fixture with controlled parent integration attempt blocked at parent face splitting.

solid box = Box(width: 10, depth: 8, height: 6);
region sideHole on box.face("+X") {
  frame faceAttached;
  circle center(0, 0) radius 1;
  cut through;
}


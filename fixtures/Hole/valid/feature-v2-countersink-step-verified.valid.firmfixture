// notes: STEP-V2-X2 semantic countersink fixture; verified through real build/export, Step242Exporter, reimport, topology markers, and analytic volume.
model FeatureV2CountersinkStepVerified {
  units mm
  solid base: Box { size: [10, 8, 6] }
  modify base {
    hole<countersink> flatHead {
      on: face(+Z)
      center: [0, 0]
      shaftDiameter: 2
      countersinkDiameter: 4
      countersinkAngle: 90
      end: throughAll
    }
  }
}

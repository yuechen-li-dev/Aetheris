// An ejector pin on the top face, which the +pull half forms: pins push the part off the −pull half.
Model Plate {
  units: mm
  RoundedRect2 outline { center: [0mm, 0mm]; size: [120mm, 60mm]; radius: 6mm }
  Profile plate { Loop Outer { outline |> TraceLoop } }
  Extrude body { profile: plate; from: 0mm; to: 2.5mm; draft: 1deg }
}

Mold PlateTool {
  part: Plate
  material: ABS
  stage: Concept
  pull: +Z
  parting: Plane { at: face(-Z) }
  Ejector e1 { at: [0mm, 0mm, 2.5mm]; diameter: 4mm }
}

Profile blankProfile = Rect2 { center: [(80mm) / 2, (50mm) / 2]; size: [80mm, 50mm] }

SheetMetal MountingBracket {
    thickness: 1.5mm;
    material: "5052-H32 Aluminum";
    kFactor: 0.42;

    base: blankProfile;

    Flange Upright {
        from: Base.Rear;
        length: 30mm;
        angle: 90deg;
        insideRadius: 2mm;
        direction: Up;
    }

    Hole Mount {
        on: Base;
        center: Point2(40mm, 20mm);
        diameter: 8mm;
    }
}

Static width: Length = 100mm
Concept Struct layout on XY {
    Rect2 blank { center: [50mm, 30mm]; size: [width, 60mm] }
    Point2 witness { position: [20mm, 30mm] }
}
Profile stock using layout { Loop Outer { blank |> TraceLoop } }
SheetMetal sharedLayout {
    thickness: 1.5mm
    Base deck { profile: stock }
    Hole mount { on: deck; center: Point2(20mm, 30mm); diameter: 6mm }
}

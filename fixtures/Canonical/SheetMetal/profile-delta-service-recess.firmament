Profile deckProfile = Rect2 { center: [(120mm) / 2, (80mm) / 2]; size: [120mm, 80mm] }

Use Profile.Modifications;

Static WallRecess: ProfileRecessSpec = ProfileRecessSpec {
    Center: 60mm;
    Lead: 6mm;
    Run: 10mm;
    Depth: 8mm;
    Land: 40mm;
}

ProfileDelta UserDefinedWallRecess = Recess < P: WallRecess, Owner: Wall.Outer >

SheetMetal DeltaTray {
    thickness: 1mm;
    Base Deck { profile: deckProfile; }
    Flange Wall { from: Deck.Front; height: 20mm; angle: 90deg; radius: 2mm; }
}

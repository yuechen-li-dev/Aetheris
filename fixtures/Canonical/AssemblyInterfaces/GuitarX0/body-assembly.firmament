include "hardware-layout.firmament";

Subassembly GuitarBody {
 <Assembly GuitarBody>
  <Part MahoganyBack = SectionChainFile<"MahoganyBack.firmament">>
   material: Mahogany;
   Placement { from: Origin; to: World; translateLocal: [0mm,0mm,0mm]; }
  </Part>
  <Part IvoryBinding = SectionChainFile<"IvoryBinding.firmament">>
   material: IvoryPolymer;
   Placement { from: Origin; to: World; translateLocal: [0mm,0mm,0mm]; }
  </Part>
  <Part CarvedMaple = SectionChainFile<"CarvedMaple.firmament">>
   material: Maple with { appearance: Sunburst; };
  </Part>
 </Assembly>

 Interface<Fixed> BodyDeckSeat { datum: GuitarLayout.HardwareDeck; members: [GuitarBody.CarvedMaple.TopSeat] }
 Mate BodyOnDeck: BodyDeckSeat { member: GuitarBody.CarvedMaple.TopSeat; at: GuitarLayout.BodySeat; orientation: SameDirection; support: true; }

 anchor: GuitarBody;
}

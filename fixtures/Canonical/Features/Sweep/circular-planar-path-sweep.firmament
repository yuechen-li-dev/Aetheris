Model UWire {
    units: mm
    Path Centerline {
        start: Point2(0mm, 0mm)
        heading: 90deg
        Line LeftLeg { length: 25mm }
        Arc Return { Radius: 6mm; Turn: -180deg }
        Line RightLeg { length: 25mm }
    }
    Sweep Wire {
        Path: Centerline
        Diameter: 1.2mm
        Material: Standard.Materials.StainlessSteel.304_Annealed
    }
}

Model EightSectionErgonomic {
 units: mm
 Concept Struct Stations {
  D0: Plane { Origin: [0mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D1: Plane { Origin: [12mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D2: Plane { Origin: [27mm,1mm,1mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D3: Plane { Origin: [43mm,2mm,2mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D4: Plane { Origin: [59mm,2mm,2mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D5: Plane { Origin: [75mm,1mm,1mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D6: Plane { Origin: [89mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
  D7: Plane { Origin: [100mm,0mm,0mm]; Normal: [1,0,0]; Up: [0,0,1] }
 }
 Construction Plane F0 { Trace: Stations.D0 }
 Construction Plane F1 { Trace: Stations.D1 }
 Construction Plane F2 { Trace: Stations.D2 }
 Construction Plane F3 { Trace: Stations.D3 }
 Construction Plane F4 { Trace: Stations.D4 }
 Construction Plane F5 { Trace: Stations.D5 }
 Construction Plane F6 { Trace: Stations.D6 }
 Construction Plane F7 { Trace: Stations.D7 }
 Path Small { start: Point2(-4mm,-3mm) heading: 0deg Line Bottom { length: 8mm } Line Right { Turn: 90deg; length: 6mm } Line Top { Turn: 90deg; length: 8mm } Close Left }
 Path Medium { start: Point2(-10mm,-7mm) heading: 0deg Line Bottom { length: 20mm } Line Right { Turn: 90deg; length: 14mm } Line Top { Turn: 90deg; length: 20mm } Close Left }
 Path Large { start: Point2(-14mm,-10mm) heading: 0deg Line Bottom { length: 28mm } Line Right { Turn: 90deg; length: 20mm } Line Top { Turn: 90deg; length: 28mm } Close Left }
 Path Peak { start: Point2(-16mm,-11mm) heading: 0deg Line Bottom { length: 32mm } Line Right { Turn: 90deg; length: 22mm } Line Top { Turn: 90deg; length: 32mm } Close Left }
 Profile PSmall from Small
 Profile PMedium from Medium
 Profile PLarge from Large
 Profile PPeak from Peak
 SectionChain EightSectionErgonomic {
  Transition: Ruled
  Section Nose { frame: F0
   profile: PSmall
   seam: Bottom }
  Section Front { frame: F1
   profile: PMedium
   seam: Bottom }
  Section PalmFront { frame: F2
   profile: PLarge
   seam: Bottom }
  Section Rise { frame: F3
   profile: PPeak
   seam: Bottom }
  Section Peak { frame: F4
   profile: PPeak
   seam: Bottom }
  Section PalmRear { frame: F5
   profile: PLarge
   seam: Bottom }
  Section Rear { frame: F6
   profile: PMedium
   seam: Bottom }
  Section Tail { frame: F7
   profile: PSmall
   seam: Bottom }
  start: Cap
  end: Cap
 }
}

    KnotsV: [0, 0, 0, 0, 0.2, 0.4, 0.6, 0.8, 1, 1, 1, 1]
    ControlRow: [[-50mm, -40mm, 20mm], [-50mm, -28mm, 20mm], [-50mm, -16mm, 20mm], [-50mm, -5mm, 20mm], [-50mm, 5mm, 20mm], [-50mm, 16mm, 20mm], [-50mm, 28mm, 20mm], [-50mm, 40mm, 20mm]]
    ControlRow: [[-42mm, -40mm, 20mm], [-42mm, -28mm, 20mm], [-42mm, -16mm, 20mm], [-42mm, -5mm, 20mm], [-42mm, 5mm, 20mm], [-42mm, 16mm, 20mm], [-42mm, 28mm, 20mm], [-42mm, 40mm, 20mm]]
    ControlRow: [[-32mm, -40mm, 20mm], [-32mm, -28mm, 20mm], [-32mm, -16mm, 20mm], [-32mm, -5mm, 20mm], [-32mm, 5mm, 20mm], [-32mm, 16mm, 20mm], [-32mm, 28mm, 20mm], [-32mm, 40mm, 20mm]]
    ControlRow: [[-20mm, -40mm, 20mm], [-20mm, -28mm, 20mm], [-20mm, -16mm, 20mm], [-20mm, -5mm, 20mm], [-20mm, 5mm, 20mm], [-20mm, 16mm, 20mm], [-20mm, 28mm, 20mm], [-20mm, 40mm, 20mm]]
    ControlRow: [[-7mm, -40mm, 20mm], [-7mm, -28mm, 20mm], [-7mm, -16mm, 23mm], [-7mm, -5mm, 28mm], [-7mm, 5mm, 28mm], [-7mm, 16mm, 23mm], [-7mm, 28mm, 20mm], [-7mm, 40mm, 20mm]]
    ControlRow: [[7mm, -40mm, 20mm], [7mm, -28mm, 20mm], [7mm, -16mm, 23mm], [7mm, -5mm, 28mm], [7mm, 5mm, 28mm], [7mm, 16mm, 23mm], [7mm, 28mm, 20mm], [7mm, 40mm, 20mm]]
    ControlRow: [[20mm, -40mm, 20mm], [20mm, -28mm, 20mm], [20mm, -16mm, 20mm], [20mm, -5mm, 20mm], [20mm, 5mm, 20mm], [20mm, 16mm, 20mm], [20mm, 28mm, 20mm], [20mm, 40mm, 20mm]]
    ControlRow: [[32mm, -40mm, 20mm], [32mm, -28mm, 20mm], [32mm, -16mm, 20mm], [32mm, -5mm, 20mm], [32mm, 5mm, 20mm], [32mm, 16mm, 20mm], [32mm, 28mm, 20mm], [32mm, 40mm, 20mm]]
    ControlRow: [[42mm, -40mm, 20mm], [42mm, -28mm, 20mm], [42mm, -16mm, 20mm], [42mm, -5mm, 20mm], [42mm, 5mm, 20mm], [42mm, 16mm, 20mm], [42mm, 28mm, 20mm], [42mm, 40mm, 20mm]]
    ControlRow: [[50mm, -40mm, 20mm], [50mm, -28mm, 20mm], [50mm, -16mm, 20mm], [50mm, -5mm, 20mm], [50mm, 5mm, 20mm], [50mm, 16mm, 20mm], [50mm, 28mm, 20mm], [50mm, 40mm, 20mm]]
    Boundary South { Existing: CrownBoundarySouth
      Continuity: G1 }
    Boundary East { Existing: CrownBoundaryEast
      Continuity: G1 }
    Boundary North { Existing: CrownBoundaryNorth
      Continuity: G1 }
    Boundary West { Existing: CrownBoundaryWest
      Continuity: G1 }
  }

  BodyState Base {
    Size: [100mm, 80mm, 20mm]
    Hole H1 { Center: [-47mm, -32mm]
      Diameter: 4mm }
    Hole H2 { Center: [47mm, -32mm]
      Diameter: 4mm }
    Hole H3 { Center: [47mm, -26mm]
      Diameter: 4mm }
    Hole H4 { Center: [-47mm, -26mm]
      Diameter: 4mm }
  }

  SculptState TrimmedCrown {
    Input: Base
    ReplaceRegion {
      Target: HousingCrown
      Patch: CrownPatchX1a
      InfluenceEnvelope: [-50mm, -40mm, 20mm, 50mm, 40mm, 28mm]
    }
    MayModify: [HousingCrown, CrownTransitionZone]
    Preserve: [BottomMountingInterface, MountingHolePattern, OuterFootprintBoundary, SideWallsLower]

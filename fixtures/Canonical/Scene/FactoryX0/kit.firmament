      Placement { from: Origin; to: World; }
    </Part>
    <Part lower = Panel<L:1050mm,W:850mm,H:440mm,R:12mm>> material: Cardboard;
      Placement { from: Origin; to: World; translateLocal: [0mm, 0mm, 160mm]; }
    </Part>
    <Part upper = Panel<L:1050mm,W:850mm,H:440mm,R:12mm>> material: Cardboard;
      Placement { from: Origin; to: World; translateLocal: [0mm, 0mm, 600mm]; }
    </Part>
    <Part band = Panel<L:70mm,W:870mm,H:900mm>> material: PaintedSteel;
      Placement { from: Origin; to: World; translateLocal: [0mm, 0mm, 155mm]; }
    </Part>
  </Assembly>
  anchor: PalletBuffer;
}
Subassembly ControlCabinet {
  <Assembly ControlCabinet>
    <Part case = Panel<L:700mm,W:550mm,H:1700mm,R:15mm>> material: PaintedSteel;
      Placement { from: Origin; to: World; }
    </Part>
    <Part door = Panel<L:630mm,W:18mm,H:1500mm>> material: Aluminium;
      Placement { from: Origin; to: World; translateLocal: [0mm, -282mm, 100mm]; }
    </Part>
    <Part display = Panel<L:420mm,W:14mm,H:280mm,R:5mm>> material: Display;
      Placement { from: Origin; to: World; translateLocal: [0mm, -299mm, 1180mm]; }
    </Part>
    <Part pull = Panel<L:25mm,W:30mm,H:160mm>> material: BlackSteel;
      Placement { from: Origin; to: World; translateLocal: [240mm, -300mm, 710mm]; }
    </Part>
  </Assembly>
  anchor: ControlCabinet;
}
